  DESKTOP
  OTHER
}

enum RetryRoundStatus {
  SCHEDULED
  RUNNING
  DONE
  CANCELLED
  SKIPPED
}

enum DripStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum DripTriggerKind {
  TAG_ADDED
  OPTED_IN
  IMPORTED
  API_CREATED
  LINK_CLICKED
  // Feature 006 (FR-028)
  ORDER_PLACED
  ORDER_DELIVERED
}

enum DripJoinVia {
  TAG_ADDED
  OPTED_IN
  IMPORTED
  API_CREATED
  LINK_CLICKED
  MANUAL
  // Feature 006 (FR-028)
  ORDER_PLACED
  ORDER_DELIVERED
}

