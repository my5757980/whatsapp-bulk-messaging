// Data model for feature 001-whatsapp-bulk-messaging (specs/.../data-model.md, T025) and
// feature 002-team-inbox live chat (specs/002-team-inbox/data-model.md, T013).
// Conventions: uuid v7 ids, snake_case tables/columns, timestamptz, money as integer USD micros.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  ADMIN
  MANAGER
  AGENT
}

enum UserStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum ConnectionStatus {
  CONNECTED
  ERROR
  DISCONNECTED
}

enum QualityRating {
  GREEN
  YELLOW
  RED
  UNKNOWN
}

enum ConsentStatus {
  OPTED_IN
  OPTED_OUT
  UNKNOWN
}

enum ConsentSource {
  IMPORT
  UPLOAD_CONFIRMATION
  API
  KEYWORD
  MANUAL
  AI_AGENT
  /// A store checkout consent confirmed by an admin to name WhatsApp (feature 006, FR-027).
  STORE
  /// A lead form consent question that names WhatsApp (feature 007, FR-037).
  LEAD_FORM
  /// A WhatsApp Form opt-in field the customer ticked (feature 008, FR-035).
  FORM
}

enum AttributeType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
}

enum ImportKind {
  CONTACTS
  CAMPAIGN_AUDIENCE
}

enum ImportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum ParameterFormat {
  POSITIONAL
  NAMED
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
  DELETED
}

enum MediaPurpose {
  TEMPLATE_SAMPLE
  CAMPAIGN_HEADER
  LIBRARY
  INBOUND
}

enum CampaignState {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum AudienceType {
  FILTER
  ALL_OPTED_IN
  UPLOAD
  RETARGET
}

enum RetargetStatus {
  FAILED
  NOT_READ
  READ
  DELIVERED
  // Feature 005 (research R6)
  CLICKED
  NOT_CLICKED
  REPLIED
  NOT_REPLIED
  HELD_BACK
  /// Feature 008 (US4): payment campaigns
  PAID
  NOT_PAID
}

enum MessageOrigin {
  CAMPAIGN
  API
  INBOX
  /// A drip step (feature 005).
  DRIP
  /// A store notification, COD message or cart reminder (feature 006).
  STORE
  /// A lead form welcome template (feature 007).
  ADS
  /// A payment template, a payment reminder or a store pay link (feature 008).
  PAYMENTS
}

enum MessageStatus {
  PENDING
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
  CANCELLED
}

enum SkipReason {
  OPTED_OUT
  NO_OPT_IN
  INVALID_NUMBER
  DUPLICATE
  MISSING_VARIABLE
  /// A payment campaign recipient without a valid amount (feature 008, R5).
  PAYMENT_AMOUNT_MISSING
}

enum MessageEventType {
  QUEUED
  SENT_ACCEPTED
  SENT
  DELIVERED
  READ
  FAILED
  RETRY_SCHEDULED
  SKIPPED
  CANCELLED
  REQUEUED
}

enum RateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
  SERVICE
}

enum NotificationType {
  CAMPAIGN_COMPLETED
  CAMPAIGN_AUTO_PAUSED
  QUALITY_DROPPED
  CREDENTIALS_FAILED
  INBOX_REQUESTING
  INBOX_TRANSFERRED
  INBOX_MENTION
  AI_USAGE
  AI_FAILING
  /// A drip paused itself (feature 005, FR-032).
  DRIP_PAUSED
  /// Feature 006: an endpoint paused after 24 hours of failures, a store connection error,
  /// an API campaign that paused itself, and a COD order cancelled by the customer.
  WEBHOOK_ENDPOINT_FAILING
  STORE_CONNECTION_ERROR
  API_CAMPAIGN_PAUSED
  COD_CANCELLED
  /// Feature 007: the ads connection failed a check, a version was rejected, an ad stopped
  /// delivering, and the month's spending cap paused the platform's ads.
  ADS_CONNECTION_ERROR
  AD_REJECTED
  AD_NOT_DELIVERING
  ADS_SPEND_CAP_REACHED
  /// Feature 008: a payment arrived, a payment arrived after expiry or cancel, the Stripe connection
  /// failed, and the catalog copy failed.
  PAYMENT_RECEIVED
  PAYMENT_PAID_LATE
  PAYMENTS_CONNECTION_ERROR
  CATALOG_SYNC_FAILED
}

// ---------- Live chat enums (feature 002) ----------

enum ConversationState {
  ACTIVE
  REQUESTING
  INTERVENED
}

enum ChatItemKind {
  INBOUND
  SESSION_OUT
  MESSAGE_REF
  NOTE
}

enum ChatOrigin {
  CUSTOMER
  MEMBER
  AUTOMATIC
  CAMPAIGN
  API
}

enum ChatContentType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  LOCATION
  CONTACTS
  BUTTON_REPLY
  LIST_REPLY
  FORM_REPLY
  REACTION
  TEMPLATE
  UNSUPPORTED
  /// Outbound interactive reply buttons and lists sent by flows (feature 003).
  BUTTONS
  LIST
  /// Feature 008: the Pay now cta_url message, product messages, the inbound cart and the outbound form.
  PAYMENT_REQUEST
  PRODUCT
  PRODUCT_LIST
  CATALOG
  ORDER
  FORM
}

enum MediaState {
  PENDING
  READY
  FAILED
}

enum JourneyEventType {
  REQUESTED
  INTERVENED
  TRANSFERRED
  RESOLVED
  AUTO_RESOLVED
  TAG_ADDED
  TAG_REMOVED
  ATTRIBUTE_CHANGED
  CONSENT_CHANGED
  BLOCKED
  UNBLOCKED
  FIRST_MESSAGE_TAG_CHANGED
  FLOW_STARTED
  FLOW_ENDED
  AI_STARTED
  AI_ENDED
  // Feature 005 (research R10)
  DRIP_JOINED
  DRIP_LEFT
  LINK_CLICKED
  // Feature 006
  CHAT_LINK_STARTED
  ORDER_PLACED
  COD_ANSWERED
  // Feature 007
  AD_CHAT_STARTED
  LEAD_RECEIVED
  // Feature 008
  PAYMENT_REQUESTED
  PAYMENT_PAID
  PAYMENT_EXPIRED
  PAYMENT_REFUNDED
  CHAT_ORDER_RECEIVED
  FORM_SUBMITTED
}

enum JourneyActor {
  MEMBER
  CUSTOMER
  SYSTEM
  FLOW
  AI_AGENT
  /// A public API key (feature 006, FR-016).
  API_KEY
}

enum AgentRuleKind {
  TAG
  ATTRIBUTE
}

enum CannedType {
  TEXT
  MEDIA
}

// ---------- Access & audit ----------

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased; uniqueness is therefore case-insensitive.
  email        String     @unique
  name         String
  passwordHash String?    @map("password_hash")
  role         Role
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  sessions        Session[]
  invitationsSent Invitation[]   @relation("InvitedBy")
  auditLogs       AuditLog[]
  notifications   Notification[]
  campaigns       Campaign[]
  apiKeys         ApiKey[]
  importJobs      ImportJob[]
  templates       Template[]
  consentEvents   ConsentEvent[]

  // Live chat (feature 002)
  conversationsOwned        Conversation[]          @relation("ConversationOwner")
  chatMessagesSent          ChatMessage[]           @relation("ChatMessageAuthor")
  openingsFirstResponded    ConversationOpening[]   @relation("OpeningFirstResponder")
  openingsIntervened        ConversationOpening[]   @relation("OpeningIntervenedBy")
  openingsResolved          ConversationOpening[]   @relation("OpeningResolvedBy")
  journeyEvents             ConversationEvent[]
  chatReadMarkers           ChatReadMarker[]
  liveChatSettingsEdits     LiveChatSettings[]
  agentRules                AgentRule[]             @relation("AgentRuleUser")
  agentRulesCreated         AgentRule[]             @relation("AgentRuleCreator")
  cannedMessages            CannedMessage[]
  cannedFavorites           CannedMessageFavorite[]
  notificationPreference    NotificationPreference?
  pushDevices               PushDevice[]
  contactsBlocked           Contact[]               @relation("ContactBlockedBy")
  messagesSent              Message[]               @relation("MessageSentBy")
  mediaUploaded             MediaAsset[]            @relation("MediaUploadedBy")
  flowsCreated              Flow[]                  @relation("FlowCreatedBy")
  flowDraftsUpdated         Flow[]                  @relation("FlowDraftUpdatedBy")
  flowVersionsCreated       FlowVersion[]           @relation("FlowVersionCreatedBy")
  flowSessionsStarted       FlowSession[]           @relation("FlowSessionStartedBy")
  flowSecretsCreated        FlowSecret[]            @relation("FlowSecretCreatedBy")
  flowSecretsUpdated        FlowSecret[]            @relation("FlowSecretUpdatedBy")
  aiAgentsCreated           AiAgent[]               @relation("AiAgentCreatedBy")
  aiAgentDraftsUpdated      AiAgent[]               @relation("AiAgentDraftUpdatedBy")
  aiAgentVersionsCreated    AiAgentVersion[]        @relation("AiAgentVersionCreatedBy")
  aiAgentNumbersAssigned    AiAgentNumber[]         @relation("AiAgentNumberAssignedBy")
  aiAgentSecretsCreated     AiAgentSecret[]         @relation("AiAgentSecretCreatedBy")
  aiAgentSecretsUpdated     AiAgentSecret[]         @relation("AiAgentSecretUpdatedBy")
  aiKnowledgeSourcesCreated AiKnowledgeSource[]     @relation("AiKnowledgeSourceCreatedBy")
  aiUnansweredResolved      AiUnansweredQuestion[]  @relation("AiUnansweredResolvedBy")
  assistantRequests         AssistantRequest[]      @relation("AssistantRequestUser")
  assistantActions          AssistantAction[]       @relation("AssistantActionUser")
  dripsCreated              Drip[]                  @relation("DripCreatedBy")
  dripEnrolmentsAdded       DripEnrolment[]         @relation("DripEnrolmentJoinedBy")

  // Feature 006
  createdWebhookEndpoints WebhookEndpoint[]       @relation("WebhookEndpointCreatedBy")
  createdApiCampaigns     ApiCampaign[]           @relation("ApiCampaignCreatedBy")
  createdStores           StoreConnection[]       @relation("StoreCreatedBy")
  confirmedStoreConsents  StoreConnection[]       @relation("StoreConsentConfirmedBy")
  updatedStoreAutomations StoreAutomation[]       @relation("StoreAutomationUpdatedBy")
  createdChatLinks        ChatLink[]              @relation("ChatLinkCreatedBy")
  numberChecks            NumberConnectionCheck[] @relation("NumberCheckRunBy")
  // Feature 007
  adsConnections          AdsConnection[]         @relation("AdsConnectedBy")
  createdAdCampaigns      AdCampaign[]            @relation("AdCampaignCreatedBy")
  createdAdAudiences      AdAudience[]            @relation("AdAudienceCreatedBy")
  createdAdLeadForms      AdLeadForm[]            @relation("AdLeadFormCreatedBy")
  paymentRequestsCreated  PaymentRequest[]        @relation("PaymentRequestCreatedBy")

  @@map("users")
}

model Invitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  email       String
  role        Role
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id") @db.Uuid
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([email])
  @@map("invitations")
}

model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id            String   @id @default(uuid(7)) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorUser     User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorApiKeyId String?  @map("actor_api_key_id") @db.Uuid
  actorApiKey   ApiKey?  @relation(fields: [actorApiKeyId], references: [id], onDelete: SetNull)
  action        String
  targetType    String   @map("target_type")
  targetId      String?  @map("target_id")
  /// Never contains secrets.
  metadata      Json     @default("{}")
  ip            String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@index([actorUserId])
  @@index([action])
  @@map("audit_logs")
}

model Settings {
  id                 Int      @id @default(1)
  defaultCountryCode String   @default("US") @map("default_country_code") @db.Char(2)
  defaultTimezone    String   @default("UTC") @map("default_timezone")
  optOutKeywords     String[] @default(["STOP", "UNSUBSCRIBE"]) @map("opt_out_keywords")
  optInKeywords      String[] @default(["START"]) @map("opt_in_keywords")
  /// AI agent (feature 004): monthly limits, USD prices per million tokens, and the limit message.
  aiReplyLimit       Int      @default(1000) @map("ai_reply_limit")
  aiAssistantLimit   Int      @default(300) @map("ai_assistant_limit")
  aiPrices           Json     @default("{\"model\":\"claude-opus-5-5\",\"input\":4,\"output\":20,\"cacheRead\":0.2,\"cacheWrite\":5}") @map("ai_prices")
  aiLimitMessage     String?  @map("ai_limit_message")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
}

// ---------- WhatsApp numbers ----------

model WhatsAppNumber {
  id                 String           @id @default(uuid(7)) @db.Uuid
  label              String
  wabaId             String           @map("waba_id")
  phoneNumberId      String           @unique @map("phone_number_id")
  displayPhoneNumber String           @map("display_phone_number")
  verifiedName       String           @map("verified_name")
  connectionStatus   ConnectionStatus @default(CONNECTED) @map("connection_status")
  qualityRating      QualityRating    @default(UNKNOWN) @map("quality_rating")
  messagingLimitTier String?          @map("messaging_limit_tier")
  throughputLevel    String?          @map("throughput_level")
  sendRatePerSecond  Int              @default(20) @map("send_rate_per_second")
  /// Kill switch (constitution Principle I): false blocks dispatch and sending.
  sendingEnabled     Boolean          @default(true) @map("sending_enabled")
  /// AES-256-GCM "v1:iv:tag:ct"; never returned by the API.
  accessTokenEnc     String           @map("access_token_enc")
  lastSyncedAt       DateTime?        @map("last_synced_at") @db.Timestamptz
  lastError          String?          @map("last_error")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  campaigns       Campaign[]
  messages        Message[]
  conversations   Conversation[]
  flowNumbers     FlowNumber[]
  flowSessions    FlowSession[]
  aiAgentNumber   AiAgentNumber?
  aiConversations AiConversation[]
  drips           Drip[]

  // Feature 006
  apiCampaigns     ApiCampaign[]
  storeConnections StoreConnection[]
  chatLinks        ChatLink[]
  connectionChecks NumberConnectionCheck[]
  // Feature 007
  adCampaigns      AdCampaign[]

  @@map("whatsapp_numbers")
}

// ---------- Contacts & consent ----------

model Contact {
  id                String         @id @default(uuid(7)) @db.Uuid
  phoneE164         String         @unique @map("phone_e164")
  countryCode       String         @map("country_code") @db.Char(2)
  name              String?
  attributes        Json           @default("{}")
  consentStatus     ConsentStatus  @default(UNKNOWN) @map("consent_status")
  consentSource     ConsentSource? @map("consent_source")
  consentSourceNote String?        @map("consent_source_note")
  consentAt         DateTime?      @map("consent_at") @db.Timestamptz
  /// Blocked contacts' messages are stored but raise no alert or automatic reply (002 FR-034).
  blockedAt         DateTime?      @map("blocked_at") @db.Timestamptz
  blockedById       String?        @map("blocked_by_id") @db.Uuid
  blockedBy         User?          @relation("ContactBlockedBy", fields: [blockedById], references: [id], onDelete: SetNull)
  /// Organic, API, Campaign upload, Import or a custom source (002 FR-033).
  leadSource        String?        @map("lead_source") @db.VarChar(80)
  firstMessageTagId String?        @map("first_message_tag_id") @db.Uuid
  firstMessageTag   Tag?           @relation("ContactFirstMessageTag", fields: [firstMessageTagId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  tags            ContactTag[]
  consentEvents   ConsentEvent[]
  messages        Message[]
  conversations   Conversation[]
  flowSessions    FlowSession[]
  aiConversations AiConversation[]
  trackedLinks    TrackedLink[]
  linkClicks      LinkClick[]
  dripEnrolments  DripEnrolment[]

  // Feature 006
  apiCampaignTriggers ApiCampaignTrigger[]
  storeOrders         StoreOrder[]
  storeCarts          StoreCart[]
  chatLinkStarts      ChatLinkStart[]
  // Feature 007
  adChatStarts        AdChatStart[]
  adLeads             AdLead[]
  paymentRequests     PaymentRequest[]
  chatOrders          ChatOrder[]
  formAnswers         FormAnswer[]

  @@index([consentStatus])
  @@index([attributes], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "contacts_name_trgm_idx")
  @@index([phoneE164(ops: raw("gin_trgm_ops"))], type: Gin, map: "contacts_phone_trgm_idx")
  @@map("contacts")
}

model Tag {
  id        String       @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased and trimmed; uniqueness is therefore case-insensitive.
  name      String       @unique
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  contacts  ContactTag[]

  agentRules            AgentRule[]
  firstMessageContacts  Contact[]     @relation("ContactFirstMessageTag")
  flowFirstMessageRules FlowTrigger[] @relation("FlowTriggerFirstMessageTag")
  dripTriggers          DripTrigger[]

  chatLinks       ChatLink[]
  // Feature 007
  adCampaigns     AdCampaign[]
  adLeadForms     AdLeadForm[]
  paymentSettings PaymentSettings[]

  @@map("tags")
}

model ContactTag {
  contactId String  @map("contact_id") @db.Uuid
  tagId     String  @map("tag_id") @db.Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
  @@map("contact_tags")
}

model AttributeDefinition {
  id        String        @id @default(uuid(7)) @db.Uuid
  key       String        @unique
  label     String
  type      AttributeType
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@map("attribute_definitions")
}

model ConsentEvent {
  id          String        @id @default(uuid(7)) @db.Uuid
  contactId   String        @map("contact_id") @db.Uuid
  contact     Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status      ConsentStatus
  source      ConsentSource
  note        String?
  actorUserId String?       @map("actor_user_id") @db.Uuid
  actorUser   User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([contactId])
  @@map("consent_events")
}

model ImportJob {
  id              String       @id @default(uuid(7)) @db.Uuid
  kind            ImportKind
  campaignId      String?      @map("campaign_id") @db.Uuid
  campaign        Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  fileKey         String       @map("file_key")
  mapping         Json         @default("{}")
  optInSourceNote String?      @map("opt_in_source_note")
  status          ImportStatus @default(QUEUED)
  totalRows       Int          @default(0) @map("total_rows")
  createdCount    Int          @default(0) @map("created_count")
  updatedCount    Int          @default(0) @map("updated_count")
  skippedCount    Int          @default(0) @map("skipped_count")
  errorCount      Int          @default(0) @map("error_count")
  columns         String[]     @default([])
  errorFileKey    String?      @map("error_file_key")
  error           String?
  createdById     String       @map("created_by_id") @db.Uuid
  createdBy       User         @relation(fields: [createdById], references: [id])
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  finishedAt      DateTime?    @map("finished_at") @db.Timestamptz

  @@index([campaignId])
  @@map("import_jobs")
}

model CampaignUploadRow {
  id         String   @id @default(uuid(7)) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  rowNumber  Int      @map("row_number")
  phoneE164  String   @map("phone_e164")
  /// Raw CSV columns, used for variable mapping.
  data       Json     @default("{}")

  @@unique([campaignId, phoneE164])
  @@map("campaign_upload_rows")
}

// ---------- Templates & media ----------

model Template {
  id                 String           @id @default(uuid(7)) @db.Uuid
  wabaId             String           @map("waba_id")
  metaTemplateId     String?          @map("meta_template_id")
  name               String
  language           String
  category           TemplateCategory
  parameterFormat    ParameterFormat  @default(POSITIONAL) @map("parameter_format")
  components         Json             @default("[]")
  variables          Json             @default("[]")
  status             TemplateStatus   @default(DRAFT)
  rejectionReason    String?          @map("rejection_reason")
  headerMediaAssetId String?          @map("header_media_asset_id") @db.Uuid
  headerMediaAsset   MediaAsset?      @relation("TemplateHeaderMedia", fields: [headerMediaAssetId], references: [id], onDelete: SetNull)
  lastSyncedAt       DateTime?        @map("last_synced_at") @db.Timestamptz
  createdById        String?          @map("created_by_id") @db.Uuid
  createdBy          User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  campaigns    Campaign[]
  messages     Message[]
  flowTriggers FlowTrigger[]
  dripSteps    DripStep[]

  apiCampaigns    ApiCampaign[]
  adLeadForms     AdLeadForm[]
  paymentSettings PaymentSettings[]

  @@unique([wabaId, name, language])
  @@index([status])
  @@map("templates")
}

model MediaAsset {
  id               String       @id @default(uuid(7)) @db.Uuid
  storageKey       String       @map("storage_key")
  mimeType         String       @map("mime_type")
  sizeBytes        Int          @map("size_bytes")
  purpose          MediaPurpose
  metaHeaderHandle String?      @map("meta_header_handle")
  /// { "<phoneNumberId>": { "id": "...", "uploadedAt": "..." } }
  metaMediaIds     Json         @default("{}") @map("meta_media_ids")
  /// Name shown in the media library (002 FR-032).
  displayName      String?      @map("display_name") @db.VarChar(240)
  uploadedById     String?      @map("uploaded_by_id") @db.Uuid
  uploadedBy       User?        @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  /// Removed from the media library; kept while sent chat messages still show it (002 FR-032).
  removedAt        DateTime?    @map("removed_at") @db.Timestamptz
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz

  templates      Template[]      @relation("TemplateHeaderMedia")
  campaigns      Campaign[]      @relation("CampaignHeaderMedia")
  chatMessages   ChatMessage[]
  cannedMessages CannedMessage[]
  dripSteps      DripStep[]      @relation("DripStepHeaderMedia")

  apiCampaignHeaders ApiCampaign[] @relation("ApiCampaignHeaderMedia")
  // Feature 007
  adVersions         AdVersion[]

  @@index([purpose, createdAt(sort: Desc)])
  @@map("media_assets")
}

// ---------- Campaigns & messages ----------

model Campaign {
  id                     String          @id @default(uuid(7)) @db.Uuid
  name                   String
  /// Nullable while a draft is incomplete; launch requires both.
  numberId               String?         @map("number_id") @db.Uuid
  number                 WhatsAppNumber? @relation(fields: [numberId], references: [id])
  templateId             String?         @map("template_id") @db.Uuid
  template               Template?       @relation(fields: [templateId], references: [id])
  state                  CampaignState   @default(DRAFT)
  audienceType           AudienceType    @default(UPLOAD) @map("audience_type")
  audienceFilter         Json?           @map("audience_filter")
  variableMapping        Json            @default("{}") @map("variable_mapping")
  headerMediaAssetId     String?         @map("header_media_asset_id") @db.Uuid
  headerMediaAsset       MediaAsset?     @relation("CampaignHeaderMedia", fields: [headerMediaAssetId], references: [id], onDelete: SetNull)
  scheduledAt            DateTime?       @map("scheduled_at") @db.Timestamptz
  timezone               String          @default("UTC")
  sourceCampaignId       String?         @map("source_campaign_id") @db.Uuid
  sourceCampaign         Campaign?       @relation("Retarget", fields: [sourceCampaignId], references: [id], onDelete: SetNull)
  retargets              Campaign[]      @relation("Retarget")
  retargetStatus         RetargetStatus? @map("retarget_status")
  pausedReason           String?         @map("paused_reason")
  launchedAt             DateTime?       @map("launched_at") @db.Timestamptz
  completedAt            DateTime?       @map("completed_at") @db.Timestamptz
  cancelledAt            DateTime?       @map("cancelled_at") @db.Timestamptz
  totals                 Json            @default("{}")
  estimatedCostUsdMicros BigInt          @default(0) @map("estimated_cost_usd_micros")
  /// Retry plan (005 FR-012): 0–3 rounds with delays in minutes, summing to at most 1,440.
  retryRounds            Int             @default(0) @map("retry_rounds") @db.SmallInt
  retryDelaysMin         Int[]           @default([]) @map("retry_delays_min")
  createdById            String          @map("created_by_id") @db.Uuid
  createdBy              User            @relation(fields: [createdById], references: [id])
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  messages           Message[]
  uploadRows         CampaignUploadRow[]
  importJobs         ImportJob[]
  trackedLinkTargets TrackedLinkTarget[]
  retryRuns          CampaignRetryRound[]
  dripTriggers       DripTrigger[]
  /// Payment requests per recipient (feature 008, R5): {amount: {source, minor?, attributeKey?}, description,
  /// expiryMinutes, tagId?, flowId?}; null when the campaign asks for no payment.
  paymentConfig      Json?                @map("payment_config")

  @@index([state])
  @@map("campaigns")
}

model Message {
  id               String         @id @default(uuid(7)) @db.Uuid
  origin           MessageOrigin
  campaignId       String?        @map("campaign_id") @db.Uuid
  campaign         Campaign?      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  apiKeyId         String?        @map("api_key_id") @db.Uuid
  apiKey           ApiKey?        @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  contactId        String?        @map("contact_id") @db.Uuid
  contact          Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  /// Null after contact deletion (FR-015).
  phoneE164        String?        @map("phone_e164")
  recipientCountry String         @map("recipient_country") @db.Char(2)
  numberId         String         @map("number_id") @db.Uuid
  number           WhatsAppNumber @relation(fields: [numberId], references: [id])
  templateId       String         @map("template_id") @db.Uuid
  template         Template       @relation(fields: [templateId], references: [id])
  resolvedParams   Json           @default("{}") @map("resolved_params")
  status           MessageStatus  @default(PENDING)
  skipReason       SkipReason?    @map("skip_reason")
  failureCode      Int?           @map("failure_code")
  failureReason    String?        @map("failure_reason")
  attempts         Int            @default(0)
  waMessageId      String?        @unique @map("wa_message_id")
  pricingCategory  String?        @map("pricing_category")
  billable         Boolean?
  costUsdMicros    BigInt?        @map("cost_usd_micros")
  queuedAt         DateTime?      @map("queued_at") @db.Timestamptz
  sentAt           DateTime?      @map("sent_at") @db.Timestamptz
  deliveredAt      DateTime?      @map("delivered_at") @db.Timestamptz
  readAt           DateTime?      @map("read_at") @db.Timestamptz
  failedAt         DateTime?      @map("failed_at") @db.Timestamptz
  /// Member who sent this template from a chat (origin INBOX, 002 R12).
  sentByUserId     String?        @map("sent_by_user_id") @db.Uuid
  sentBy           User?          @relation("MessageSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)
  /// Sent by a welcome or off-hours rule (002 R10).
  automatic        Boolean        @default(false)
  /// The last retry round that re-sent this message (005 FR-013); 0 for the first pass.
  retryRound       Int            @default(0) @map("retry_round") @db.SmallInt
  /// Drip step messages (origin DRIP, feature 005); they have no campaign.
  dripEnrolmentId  String?        @map("drip_enrolment_id") @db.Uuid
  dripEnrolment    DripEnrolment? @relation(fields: [dripEnrolmentId], references: [id], onDelete: SetNull)
  dripStepId       String?        @map("drip_step_id") @db.Uuid
  dripStep         DripStep?      @relation(fields: [dripStepId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  events             MessageEvent[]
  idempotencyRecords IdempotencyRecord[]
  chatItem           ChatMessage?
  trackedLinks       TrackedLink[]
  dripStepSends      DripStepSend[]

  /// At most one message per recipient per campaign (FR-022). NULLs are distinct in Postgres,
  /// so API messages (no campaign) and anonymised rows (no contact) never collide.
  // Feature 006
  apiCampaignId       String?              @map("api_campaign_id") @db.Uuid
  apiCampaign         ApiCampaign?         @relation(fields: [apiCampaignId], references: [id], onDelete: SetNull)
  storeOrderId        String?              @map("store_order_id") @db.Uuid
  storeOrder          StoreOrder?          @relation(fields: [storeOrderId], references: [id], onDelete: SetNull)
  storeCartId         String?              @map("store_cart_id") @db.Uuid
  storeCart           StoreCart?           @relation(fields: [storeCartId], references: [id], onDelete: SetNull)
  /// A lead form welcome template (feature 007).
  adLeadId            String?              @map("ad_lead_id") @db.Uuid
  adLead              AdLead?              @relation(fields: [adLeadId], references: [id], onDelete: SetNull)
  apiCampaignTriggers ApiCampaignTrigger[]
  storeOrderMessages  StoreOrderMessage[]
  storeCartReminders  StoreCartReminder[]

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([apiKeyId, createdAt])
  @@index([dripStepId])
  @@index([dripEnrolmentId])
  @@index([apiCampaignId])
  @@index([storeOrderId])
  @@index([adLeadId])
  @@index([storeCartId])
  @@map("messages")
}

model MessageEvent {
  id         String           @id @default(uuid(7)) @db.Uuid
  messageId  String           @map("message_id") @db.Uuid
  message    Message          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type       MessageEventType
  occurredAt DateTime         @map("occurred_at") @db.Timestamptz
  payload    Json             @default("{}")
  /// e.g. "wamid.X:delivered" or "<messageId>:retry:<n>"; makes event writes idempotent.
  dedupeKey  String           @unique @map("dedupe_key")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([messageId])
  @@map("message_events")
}

model WebhookEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz
  signatureValid Boolean   @map("signature_valid")
  /// Raw body; null when the signature was invalid. Retained 30 days.
  payload        Json?
  processedAt    DateTime? @map("processed_at") @db.Timestamptz
  error          String?

  @@index([receivedAt])
  @@map("webhook_events")
}

// ---------- Cost, API & notifications ----------

model RateCardEntry {
  id             String       @id @default(uuid(7)) @db.Uuid
  category       RateCategory
  /// ISO-2 country code, or "*" as the default rate.
  countryCode    String       @map("country_code") @db.VarChar(2)
  priceUsdMicros BigInt       @map("price_usd_micros")
  effectiveFrom  DateTime     @map("effective_from") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@unique([category, countryCode, effectiveFrom])
  @@map("rate_card_entries")
}

model ApiKey {
  id                 String    @id @default(uuid(7)) @db.Uuid
  name               String
  prefix             String    @db.Char(8)
  keyHash            String    @unique @map("key_hash")
  last4              String    @db.Char(4)
  rateLimitPerMinute Int       @default(60) @map("rate_limit_per_minute")
  createdById        String    @map("created_by_id") @db.Uuid
  createdBy          User      @relation(fields: [createdById], references: [id])
  lastUsedAt         DateTime? @map("last_used_at") @db.Timestamptz
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  messages           Message[]
  idempotencyRecords IdempotencyRecord[]
  auditLogs          AuditLog[]

  /// What the key may do (feature 006, FR-010); keys made before 006 can only send messages.
  scopes              String[]             @default(["messages.send"])
  apiCampaignTriggers ApiCampaignTrigger[]

  idempotentResponses ApiIdempotentResponse[]

  @@index([prefix])
  @@map("api_keys")
}

model IdempotencyRecord {
  id          String   @id @default(uuid(7)) @db.Uuid
  apiKeyId    String   @map("api_key_id") @db.Uuid
  apiKey      ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  key         String   @db.VarChar(255)
  requestHash String   @map("request_hash")
  messageId   String   @map("message_id") @db.Uuid
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([apiKeyId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

/// One row per recipient user (admin notifications are fanned out at creation time).
model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?        @map("read_at") @db.Timestamptz
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, readAt])
  @@map("notifications")
}

// ---------- Live chat (feature 002, specs/002-team-inbox/data-model.md) ----------

/// One chat per contact per company number. The 24-hour window is derived from
/// last_customer_message_at and never stored (research R5).
model Conversation {
  id                    String            @id @default(uuid(7)) @db.Uuid
  contactId             String?           @map("contact_id") @db.Uuid
  contact               Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  numberId              String            @map("number_id") @db.Uuid
  number                WhatsAppNumber    @relation(fields: [numberId], references: [id])
  state                 ConversationState @default(ACTIVE)
  /// Required while state = INTERVENED (check constraint in the migration).
  intervenedById        String?           @map("intervened_by_id") @db.Uuid
  intervenedBy          User?             @relation("ConversationOwner", fields: [intervenedById], references: [id], onDelete: SetNull)
  intervenedAt          DateTime?         @map("intervened_at") @db.Timestamptz
  lastCustomerMessageAt DateTime?         @map("last_customer_message_at") @db.Timestamptz
  lastInboundAt         DateTime?         @map("last_inbound_at") @db.Timestamptz
  lastActivityAt        DateTime          @default(now()) @map("last_activity_at") @db.Timestamptz
  lastMessagePreview    String?           @map("last_message_preview") @db.VarChar(120)
  /// "Talk to a person" requests since the chat was last resolved (FR-021).
  unresolvedRequests    Int               @default(0) @map("unresolved_requests")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  items           ChatMessage[]
  openings        ConversationOpening[]
  events          ConversationEvent[]
  readMarkers     ChatReadMarker[]
  flowSessions    FlowSession[]
  aiConversations AiConversation[]

  /// NULL contact ids (after erasure) stay distinct.
  chatLinkStarts  ChatLinkStart[]
  adChatStarts    AdChatStart[]
  paymentRequests PaymentRequest[]
  chatOrders      ChatOrder[]

  @@unique([contactId, numberId])
  @@index([state, lastActivityAt(sort: Desc)])
  @@index([intervenedById])
  @@index([numberId, lastActivityAt(sort: Desc)])
  @@index([lastCustomerMessageAt])
  @@map("conversations")
}

/// Every timeline item: inbound messages, free-form replies, notes and references to messages rows.
model ChatMessage {
  id             String          @id @default(uuid(7)) @db.Uuid
  conversationId String          @map("conversation_id") @db.Uuid
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  kind           ChatItemKind
  origin         ChatOrigin
  contentType    ChatContentType @map("content_type")
  /// Body, caption or note; null after contact erasure.
  text           String?
  payload        Json            @default("{}")
  mediaAssetId   String?         @map("media_asset_id") @db.Uuid
  mediaAsset     MediaAsset?     @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  mediaState     MediaState?     @map("media_state")
  /// MESSAGE_REF rows point to a campaign, API or inbox-template message (check constraint).
  messageId      String?         @unique @map("message_id") @db.Uuid
  message        Message?        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// Customer wamid (INBOUND) or ours (SESSION_OUT); unique, so repeated webhooks add nothing.
  waMessageId    String?         @unique @map("wa_message_id")
  replyToWaId    String?         @map("reply_to_wa_id")
  /// SESSION_OUT only, reusing the 001 status enum.
  status         MessageStatus?
  failureCode    Int?            @map("failure_code")
  failureReason  String?         @map("failure_reason")
  attempts       Int             @default(0)
  sentByUserId   String?         @map("sent_by_user_id") @db.Uuid
  sentBy         User?           @relation("ChatMessageAuthor", fields: [sentByUserId], references: [id], onDelete: SetNull)
  occurredAt     DateTime        @map("occurred_at") @db.Timestamptz
  sentAt         DateTime?       @map("sent_at") @db.Timestamptz
  deliveredAt    DateTime?       @map("delivered_at") @db.Timestamptz
  readAt         DateTime?       @map("read_at") @db.Timestamptz
  failedAt       DateTime?       @map("failed_at") @db.Timestamptz
  /// Waiting for an AI agent's reply (004 research R5): the AI router sets it, the turn that answers clears it.
  aiPending      Boolean         @default(false) @map("ai_pending")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  aiReplies      AiReply[]

  @@index([conversationId, occurredAt, id])
  @@map("chat_messages")
}

/// One row per conversation start, for team metrics and the once-only welcome message.
model ConversationOpening {
  id                String       @id @default(uuid(7)) @db.Uuid
  conversationId    String       @map("conversation_id") @db.Uuid
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  openedAt          DateTime     @map("opened_at") @db.Timestamptz
  firstHumanReplyAt DateTime?    @map("first_human_reply_at") @db.Timestamptz
  firstResponderId  String?      @map("first_responder_id") @db.Uuid
  firstResponder    User?        @relation("OpeningFirstResponder", fields: [firstResponderId], references: [id], onDelete: SetNull)
  intervenedAt      DateTime?    @map("intervened_at") @db.Timestamptz
  intervenedById    String?      @map("intervened_by_id") @db.Uuid
  intervenedBy      User?        @relation("OpeningIntervenedBy", fields: [intervenedById], references: [id], onDelete: SetNull)
  resolvedAt        DateTime?    @map("resolved_at") @db.Timestamptz
  /// Null for auto-resolve.
  resolvedById      String?      @map("resolved_by_id") @db.Uuid
  resolvedBy        User?        @relation("OpeningResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  welcomeSentAt     DateTime?    @map("welcome_sent_at") @db.Timestamptz
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([conversationId, openedAt(sort: Desc)])
  @@index([openedAt])
  @@map("conversation_openings")
}

/// The customer journey shown beside a chat.
model ConversationEvent {
  id             String           @id @default(uuid(7)) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type           JourneyEventType
  actorType      JourneyActor     @map("actor_type")
  actorUserId    String?          @map("actor_user_id") @db.Uuid
  actorUser      User?            @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  data           Json             @default("{}")
  occurredAt     DateTime         @default(now()) @map("occurred_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([conversationId, occurredAt(sort: Desc)])
  @@map("conversation_events")
}

model ChatReadMarker {
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @map("last_read_at") @db.Timestamptz

  @@id([userId, conversationId])
  @@index([conversationId])
  @@map("chat_read_markers")
}

/// Singleton (id = 1, check constraint), created on first use.
model LiveChatSettings {
  id              Int      @id @default(1)
  /// IANA time zone for working hours.
  timezone        String   @default("UTC")
  /// {"mon":[["09:00","18:00"]], ..., "sun":[]}
  workingHours    Json     @default("{\"mon\":[[\"09:00\",\"18:00\"]],\"tue\":[[\"09:00\",\"18:00\"]],\"wed\":[[\"09:00\",\"18:00\"]],\"thu\":[[\"09:00\",\"18:00\"]],\"fri\":[[\"09:00\",\"18:00\"]],\"sat\":[],\"sun\":[]}") @map("working_hours")
  welcomeEnabled  Boolean  @default(false) @map("welcome_enabled")
  welcomeContent  Json?    @map("welcome_content")
  offHoursEnabled Boolean  @default(false) @map("off_hours_enabled")
  offHoursContent Json?    @map("off_hours_content")
  /// At most 5, normalised (trimmed, single spaces, upper-case).
  humanKeywords   String[] @default([]) @map("human_keywords")
  autoResolve     Boolean  @default(false) @map("auto_resolve")
  updatedById     String?  @map("updated_by_id") @db.Uuid
  updatedBy       User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("live_chat_settings")
}

/// Limits an agent to chats whose contact matches any rule (FR-028). Replaced as a whole set, so
/// duplicates are removed by the service (NULL columns make a unique index ineffective here).
model AgentRule {
  id             String        @id @default(uuid(7)) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  user           User          @relation("AgentRuleUser", fields: [userId], references: [id], onDelete: Cascade)
  kind           AgentRuleKind
  tagId          String?       @map("tag_id") @db.Uuid
  tag            Tag?          @relation(fields: [tagId], references: [id], onDelete: Cascade)
  attributeKey   String?       @map("attribute_key")
  attributeValue String?       @map("attribute_value")
  createdById    String?       @map("created_by_id") @db.Uuid
  createdBy      User?         @relation("AgentRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("agent_rules")
}

/// Saved replies (FR-030), at most 200; names are unique ignoring case (citext).
model CannedMessage {
  id                String      @id @default(uuid(7)) @db.Uuid
  name              String      @unique @db.Citext
  type              CannedType
  text              String?     @db.VarChar(4096)
  /// {"first_name":"there","attr:city":"your city"}
  variableFallbacks Json        @default("{}") @map("variable_fallbacks")
  mediaAssetId      String?     @map("media_asset_id") @db.Uuid
  mediaAsset        MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  mediaUrl          String?     @map("media_url")
  fileName          String?     @map("file_name") @db.VarChar(240)
  createdById       String?     @map("created_by_id") @db.Uuid
  createdBy         User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  favorites CannedMessageFavorite[]

  @@map("canned_messages")
}

model CannedMessageFavorite {
  userId          String        @map("user_id") @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cannedMessageId String        @map("canned_message_id") @db.Uuid
  cannedMessage   CannedMessage @relation(fields: [cannedMessageId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, cannedMessageId])
  @@map("canned_message_favorites")
}

/// Created on first change; sound is on by default.
model NotificationPreference {
  userId       String   @id @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  soundEnabled Boolean  @default(true) @map("sound_enabled")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("notification_preferences")
}

/// Browser push subscriptions, at most 5 per user (FR-037); removed on a 404 or 410 from the push service.
model PushDevice {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  label         String    @db.VarChar(80)
  paused        Boolean   @default(false)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId])
  @@map("push_devices")
}

// ---------- Chatbot flows (feature 003, specs/003-chatbot-flow-builder/data-model.md) ----------

enum FlowStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum FlowVersionKind {
  PUBLISHED
  REVISION
}

enum FlowTriggerKind {
  KEYWORD
  PATTERN
  TEMPLATE_BUTTON
  FIRST_MESSAGE
}

enum KeywordMatch {
  EXACT
  CONTAINS
}

enum FlowSessionStatus {
  RUNNING
  ENDED
}

enum FlowSessionResult {
  COMPLETED
  HANDED_TO_AI
  HANDED_OVER
  TIMED_OUT
  STOPPED_BY_MEMBER
  OPTED_OUT
  INTERRUPTED
  WINDOW_CLOSED
  SEND_FAILED
  FLOW_UNPUBLISHED
  EXPIRED
  BLOCKED
  FAILED
}

enum FlowWait {
  NONE
  INPUT
  DELAY
  API
  /// Feature 008: waiting for a payment, a cart (product and catalog steps) or a form answer.
  PAYMENT
  ORDER
  FORM
}

enum FlowStartedBy {
  TRIGGER
  MEMBER
  JUMP
  AI_AGENT
}

/// A chatbot flow with its editable draft graph (contracts/flow-graph.md). Names are unique among
/// flows that are not deleted (partial unique index in the migration).
model Flow {
  id                 String       @id @default(uuid(7)) @db.Uuid
  name               String       @db.Citext
  status             FlowStatus   @default(DRAFT)
  /// Lower runs first when triggers tie (FR-020).
  priority           Int          @default(100)
  allNumbers         Boolean      @default(true) @map("all_numbers")
  publishedVersionId String?      @unique @map("published_version_id") @db.Uuid
  publishedVersion   FlowVersion? @relation("FlowPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  draft              Json         @default("{}")
  /// +1 on every draft save; an older revision gets 409 DRAFT_CONFLICT.
  draftRevision      Int          @default(0) @map("draft_revision")
  draftUpdatedAt     DateTime?    @map("draft_updated_at") @db.Timestamptz
  draftUpdatedById   String?      @map("draft_updated_by_id") @db.Uuid
  draftUpdatedBy     User?        @relation("FlowDraftUpdatedBy", fields: [draftUpdatedById], references: [id], onDelete: SetNull)
  /// E.164 numbers that run the draft (at most 3, check constraint in the migration).
  testNumbers        String[]     @default([]) @map("test_numbers")
  starterKey         String?      @map("starter_key") @db.VarChar(40)
  createdById        String?      @map("created_by_id") @db.Uuid
  createdBy          User?        @relation("FlowCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?    @map("deleted_at") @db.Timestamptz

  versions FlowVersion[] @relation("FlowVersions")
  numbers  FlowNumber[]
  triggers FlowTrigger[]
  sessions FlowSession[]
  secrets  FlowSecret[]

  chatLinks   ChatLink[]
  adCampaigns AdCampaign[]

  @@map("flows")
}

model FlowNumber {
  flowId   String         @map("flow_id") @db.Uuid
  flow     Flow           @relation(fields: [flowId], references: [id], onDelete: Cascade)
  numberId String         @map("number_id") @db.Uuid
  number   WhatsAppNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)

  @@id([flowId, numberId])
  @@index([numberId])
  @@map("flow_numbers")
}

/// Published versions (numbered, immutable) and autosave revisions (last 20 kept).
model FlowVersion {
  id          String          @id @default(uuid(7)) @db.Uuid
  flowId      String          @map("flow_id") @db.Uuid
  flow        Flow            @relation("FlowVersions", fields: [flowId], references: [id], onDelete: Cascade)
  kind        FlowVersionKind
  /// 1, 2, 3… for published versions; null for revisions (NULLs stay distinct in the unique index).
  number      Int?
  graph       Json
  createdById String?         @map("created_by_id") @db.Uuid
  createdBy   User?           @relation("FlowVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz

  publishedFor Flow?         @relation("FlowPublishedVersion")
  triggers     FlowTrigger[]
  sessions     FlowSession[]

  @@unique([flowId, number])
  @@index([flowId, kind, createdAt(sort: Desc)])
  @@map("flow_versions")
}

/// Triggers of published versions, written on publish for fast matching (research R2).
model FlowTrigger {
  id                String          @id @default(uuid(7)) @db.Uuid
  flowId            String          @map("flow_id") @db.Uuid
  flow              Flow            @relation(fields: [flowId], references: [id], onDelete: Cascade)
  flowVersionId     String          @map("flow_version_id") @db.Uuid
  flowVersion       FlowVersion     @relation(fields: [flowVersionId], references: [id], onDelete: Cascade)
  triggerKey        String          @map("trigger_key") @db.VarChar(40)
  kind              FlowTriggerKind
  match             KeywordMatch?
  /// Normalised: lower case, single spaces, trimmed.
  phrase            String?         @db.VarChar(200)
  pattern           String?         @db.VarChar(200)
  templateId        String?         @map("template_id") @db.Uuid
  template          Template?       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  buttonText        String?         @map("button_text") @db.VarChar(25)
  firstMessageTagId String?         @map("first_message_tag_id") @db.Uuid
  firstMessageTag   Tag?            @relation("FlowTriggerFirstMessageTag", fields: [firstMessageTagId], references: [id], onDelete: SetNull)
  /// First-message rules can only set the tag without starting the flow.
  startFlow         Boolean         @default(true) @map("start_flow")
  /// Pattern triggers can store the matched text as an answer.
  answerName        String?         @map("answer_name") @db.VarChar(40)
  canInterrupt      Boolean         @default(false) @map("can_interrupt")

  @@index([kind, phrase])
  @@index([templateId, buttonText])
  @@index([flowId])
  @@map("flow_triggers")
}

/// One contact's run through one flow version (data-model.md §3). At most one RUNNING session per
/// conversation (partial unique index in the migration).
model FlowSession {
  id              String             @id @default(uuid(7)) @db.Uuid
  flowId          String             @map("flow_id") @db.Uuid
  flow            Flow               @relation(fields: [flowId], references: [id], onDelete: Cascade)
  /// Null for test sessions running a draft.
  flowVersionId   String?            @map("flow_version_id") @db.Uuid
  flowVersion     FlowVersion?       @relation(fields: [flowVersionId], references: [id], onDelete: SetNull)
  conversationId  String             @map("conversation_id") @db.Uuid
  conversation    Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Null after contact erasure.
  contactId       String?            @map("contact_id") @db.Uuid
  contact         Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  numberId        String             @map("number_id") @db.Uuid
  number          WhatsAppNumber     @relation(fields: [numberId], references: [id], onDelete: Cascade)
  status          FlowSessionStatus  @default(RUNNING)
  result          FlowSessionResult?
  failureReason   String?            @map("failure_reason") @db.VarChar(120)
  currentStepId   String?            @map("current_step_id") @db.VarChar(40)
  wait            FlowWait           @default(NONE)
  /// +1 on every move; timers, API jobs and reply ids carry it so stale ones do nothing.
  waitToken       Int                @default(0) @map("wait_token")
  waitUntil       DateTime?          @map("wait_until") @db.Timestamptz
  retries         Int                @default(0)
  stepsSinceInput Int                @default(0) @map("steps_since_input")
  answers         Json               @default("{}")
  isTest          Boolean            @default(false) @map("is_test")
  startedBy       FlowStartedBy      @map("started_by")
  startedByUserId String?            @map("started_by_user_id") @db.Uuid
  startedByUser   User?              @relation("FlowSessionStartedBy", fields: [startedByUserId], references: [id], onDelete: SetNull)
  triggerKey      String?            @map("trigger_key") @db.VarChar(40)
  parentSessionId String?            @map("parent_session_id") @db.Uuid
  startedAt       DateTime           @default(now()) @map("started_at") @db.Timestamptz
  lastActivityAt  DateTime           @default(now()) @map("last_activity_at") @db.Timestamptz
  endedAt         DateTime?          @map("ended_at") @db.Timestamptz

  steps FlowSessionStep[]

  @@index([status, lastActivityAt])
  @@index([flowId, startedAt])
  @@index([conversationId, startedAt(sort: Desc)])
  @@map("flow_sessions")
}

/// Each step a (non-test) session entered and how it left, for analytics (research R12).
model FlowSessionStep {
  id            BigInt      @id @default(autoincrement())
  sessionId     String      @map("session_id") @db.Uuid
  session       FlowSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  flowId        String      @map("flow_id") @db.Uuid
  flowVersionId String?     @map("flow_version_id") @db.Uuid
  stepId        String      @map("step_id") @db.VarChar(40)
  enteredAt     DateTime    @default(now()) @map("entered_at") @db.Timestamptz
  leftAt        DateTime?   @map("left_at") @db.Timestamptz
  branch        String?     @db.VarChar(60)

  @@index([flowId, flowVersionId, stepId, enteredAt])
  @@index([sessionId])
  @@map("flow_session_steps")
}

/// Encrypted header values for API steps (001 TokenCipher); never returned by the API.
model FlowSecret {
  id             String   @id @default(uuid(7)) @db.Uuid
  flowId         String   @map("flow_id") @db.Uuid
  flow           Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  name           String   @db.VarChar(60)
  valueEncrypted String   @map("value_encrypted")
  createdById    String?  @map("created_by_id") @db.Uuid
  createdBy      User?    @relation("FlowSecretCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById    String?  @map("updated_by_id") @db.Uuid
  updatedBy      User?    @relation("FlowSecretUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([flowId])
  @@map("flow_secrets")
}

// ---------- AI agent (feature 004, specs/004-ai-agent/data-model.md) ----------

enum AiAgentStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum AiKnowledgeKind {
  ANSWER
  WEBSITE
  FILE
}

enum AiKnowledgeStatus {
  PROCESSING
  READY
  FAILED
}

enum AiStartedBy {
  CUSTOMER
  FLOW
}

enum AiConversationStatus {
  ACTIVE
  ENDED
}

enum AiConversationResult {
  HANDED_OVER
  MEMBER_TOOK
  CLOSED
  EXPIRED
  LIMIT_REACHED
  FAILED
  OPTED_OUT
  BLOCKED
  UNPUBLISHED
}

enum AiReplyKind {
  REPLY
  HANDOVER
  FALLBACK
  LIMIT
}

enum AiUsageKind {
  REPLY
  PREVIEW
  ASSISTANT
}

enum AssistantRequestStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum AssistantActionKind {
  SEND_CAMPAIGN
  SCHEDULE_CAMPAIGN
  DELETE_CONTACTS
  DELETE_TAGS
}

enum AssistantActionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  FAILED
}

/// An AI agent with its editable draft configuration (contracts/agent-config.md). Names are unique
/// among agents that are not deleted (partial unique index in the migration).
model AiAgent {
  id                 String          @id @default(uuid(7)) @db.Uuid
  name               String          @db.Citext
  status             AiAgentStatus   @default(DRAFT)
  draft              Json            @default("{}")
  /// +1 on every draft save; an older revision gets 409 DRAFT_CONFLICT.
  draftRevision      Int             @default(0) @map("draft_revision")
  draftUpdatedAt     DateTime?       @map("draft_updated_at") @db.Timestamptz
  draftUpdatedById   String?         @map("draft_updated_by_id") @db.Uuid
  draftUpdatedBy     User?           @relation("AiAgentDraftUpdatedBy", fields: [draftUpdatedById], references: [id], onDelete: SetNull)
  publishedVersionId String?         @unique @map("published_version_id") @db.Uuid
  publishedVersion   AiAgentVersion? @relation("AiAgentPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  /// E.164 numbers that meet the draft (at most 3, check constraint in the migration).
  testNumbers        String[]        @default([]) @map("test_numbers")
  starterKey         String?         @map("starter_key") @db.VarChar(40)
  createdById        String?         @map("created_by_id") @db.Uuid
  createdBy          User?           @relation("AiAgentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  /// Soft delete, so AI reply history keeps its agent.
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz

  versions            AiAgentVersion[]       @relation("AiAgentVersions")
  numbers             AiAgentNumber[]
  secrets             AiAgentSecret[]
  knowledgeSources    AiKnowledgeSource[]
  conversations       AiConversation[]
  unansweredQuestions AiUnansweredQuestion[]

  @@map("ai_agents")
}

/// Published versions of an agent's configuration (numbered, immutable).
model AiAgentVersion {
  id          String   @id @default(uuid(7)) @db.Uuid
  agentId     String   @map("agent_id") @db.Uuid
  agent       AiAgent  @relation("AiAgentVersions", fields: [agentId], references: [id], onDelete: Cascade)
  number      Int
  config      Json
  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   User?    @relation("AiAgentVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  publishedFor  AiAgent?         @relation("AiAgentPublishedVersion")
  conversations AiConversation[]

  @@unique([agentId, number])
  @@map("ai_agent_versions")
}

/// The agent that answers a number's messages that no flow trigger matched (one per number, FR-004).
model AiAgentNumber {
  numberId     String         @id @map("number_id") @db.Uuid
  number       WhatsAppNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)
  agentId      String         @map("agent_id") @db.Uuid
  agent        AiAgent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  assignedById String?        @map("assigned_by_id") @db.Uuid
  assignedBy   User?          @relation("AiAgentNumberAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt   DateTime       @default(now()) @map("assigned_at") @db.Timestamptz

  @@index([agentId])
  @@map("ai_agent_numbers")
}

/// Header secrets for API skills, encrypted with the 001 TokenCipher; never returned or logged.
model AiAgentSecret {
  id             String   @id @default(uuid(7)) @db.Uuid
  agentId        String   @map("agent_id") @db.Uuid
  agent          AiAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name           String   @db.VarChar(60)
  valueEncrypted String   @map("value_encrypted")
  createdById    String?  @map("created_by_id") @db.Uuid
  createdBy      User?    @relation("AiAgentSecretCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById    String?  @map("updated_by_id") @db.Uuid
  updatedBy      User?    @relation("AiAgentSecretUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([agentId])
  @@map("ai_agent_secrets")
}

/// A written answer, a website or a file the agent answers from (shared by draft and versions).
model AiKnowledgeSource {
  id              String            @id @default(uuid(7)) @db.Uuid
  agentId         String            @map("agent_id") @db.Uuid
  agent           AiAgent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  kind            AiKnowledgeKind
  title           String            @db.VarChar(200)
  enabled         Boolean           @default(true)
  status          AiKnowledgeStatus @default(PROCESSING)
  errorCode       String?           @map("error_code") @db.VarChar(40)
  errorMessage    String?           @map("error_message")
  question        String?
  answer          String?
  /// Example answers from a starter that must be replaced before publishing (FR-005).
  replaceMe       Boolean           @default(false) @map("replace_me")
  url             String?
  refreshWeekly   Boolean           @default(false) @map("refresh_weekly")
  pagesRead       Int?              @map("pages_read")
  storageKey      String?           @map("storage_key")
  fileName        String?           @map("file_name")
  mimeType        String?           @map("mime_type")
  sizeBytes       Int?              @map("size_bytes")
  /// Duplicate files are refused per agent (partial unique index in the migration).
  sha256          String?           @db.Char(64)
  charCount       Int               @default(0) @map("char_count")
  chunkCount      Int               @default(0) @map("chunk_count")
  lastRefreshedAt DateTime?         @map("last_refreshed_at") @db.Timestamptz
  createdById     String?           @map("created_by_id") @db.Uuid
  createdBy       User?             @relation("AiKnowledgeSourceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  chunks AiKnowledgeChunk[]

  @@index([agentId, kind])
  @@map("ai_knowledge_sources")
}

/// About 1,500 characters of a source's text, searchable through the generated tsvector (research R4).
model AiKnowledgeChunk {
  id        String                   @id @default(uuid(7)) @db.Uuid
  sourceId  String                   @map("source_id") @db.Uuid
  source    AiKnowledgeSource        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// Copied from the source, for search.
  agentId   String                   @map("agent_id") @db.Uuid
  position  Int
  title     String
  heading   String?
  url       String?
  page      Int?
  text      String
  /// Generated in the migration from title, heading and text; read through $queryRaw only.
  tsv       Unsupported("tsvector")?
  createdAt DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  @@index([agentId])
  @@index([sourceId, position])
  @@map("ai_knowledge_chunks")
}

/// One stretch of a chat answered by one agent (data-model.md §3). At most one ACTIVE per chat
/// (partial unique index in the migration).
model AiConversation {
  id                  String                @id @default(uuid(7)) @db.Uuid
  conversationId      String                @map("conversation_id") @db.Uuid
  conversation        Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agentId             String                @map("agent_id") @db.Uuid
  agent               AiAgent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Last version that answered; null for draft (test) turns.
  versionId           String?               @map("version_id") @db.Uuid
  version             AiAgentVersion?       @relation(fields: [versionId], references: [id], onDelete: SetNull)
  /// Null after contact erasure.
  contactId           String?               @map("contact_id") @db.Uuid
  contact             Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  numberId            String                @map("number_id") @db.Uuid
  number              WhatsAppNumber        @relation(fields: [numberId], references: [id], onDelete: Cascade)
  test                Boolean               @default(false)
  startedBy           AiStartedBy           @map("started_by")
  status              AiConversationStatus  @default(ACTIVE)
  result              AiConversationResult?
  /// AI replies sent in this conversation (the reply cap, FR-023).
  replies             Int                   @default(0)
  /// Time of the last customer message a reply covered.
  lastHandledAt       DateTime?             @map("last_handled_at") @db.Timestamptz
  pendingConfirmation Json?                 @map("pending_confirmation")
  unansweredStreak    Json?                 @map("unanswered_streak")
  summary             String?
  startedAt           DateTime              @default(now()) @map("started_at") @db.Timestamptz
  lastActivityAt      DateTime              @default(now()) @map("last_activity_at") @db.Timestamptz
  endedAt             DateTime?             @map("ended_at") @db.Timestamptz

  replyRecords   AiReply[]
  unansweredAsks AiUnansweredAsk[]

  @@index([conversationId])
  @@index([status, lastActivityAt])
  @@map("ai_conversations")
}

/// The details of one AI reply or fixed message: what it used and what it cost (FR-020, FR-036).
model AiReply {
  id               String         @id @default(uuid(7)) @db.Uuid
  aiConversationId String         @map("ai_conversation_id") @db.Uuid
  aiConversation   AiConversation @relation(fields: [aiConversationId], references: [id], onDelete: Cascade)
  chatMessageId    String?        @map("chat_message_id") @db.Uuid
  chatMessage      ChatMessage?   @relation(fields: [chatMessageId], references: [id], onDelete: SetNull)
  /// Copied references (no foreign keys), so history survives number or agent removal.
  agentId          String         @map("agent_id") @db.Uuid
  versionId        String?        @map("version_id") @db.Uuid
  numberId         String?        @map("number_id") @db.Uuid
  kind             AiReplyKind
  test             Boolean        @default(false)
  counted          Boolean        @default(false)
  language         String?        @db.VarChar(10)
  sources          Json           @default("[]")
  skills           Json           @default("[]")
  modelId          String         @map("model") @db.VarChar(60)
  inputTokens      Int            @default(0) @map("input_tokens")
  cacheReadTokens  Int            @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int            @default(0) @map("cache_write_tokens")
  outputTokens     Int            @default(0) @map("output_tokens")
  costMicros       BigInt         @default(0) @map("cost_micros")
  durationMs       Int            @default(0) @map("duration_ms")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@index([aiConversationId])
  @@index([agentId, createdAt])
  @@index([createdAt])
  @@map("ai_replies")
}

/// Questions the agent could not answer (FR-015). Open questions are unique per agent and text
/// (partial unique index in the migration).
model AiUnansweredQuestion {
  id           String    @id @default(uuid(7)) @db.Uuid
  agentId      String    @map("agent_id") @db.Uuid
  agent        AiAgent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  text         String    @db.VarChar(300)
  normalized   String    @db.VarChar(300)
  askCount     Int       @default(0) @map("ask_count")
  firstAskedAt DateTime  @default(now()) @map("first_asked_at") @db.Timestamptz
  lastAskedAt  DateTime  @default(now()) @map("last_asked_at") @db.Timestamptz
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz
  resolvedById String?   @map("resolved_by_id") @db.Uuid
  resolvedBy   User?     @relation("AiUnansweredResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  asks AiUnansweredAsk[]

  @@index([agentId, resolvedAt])
  @@map("ai_unanswered_questions")
}

/// One time a question was asked, linked to its AI conversation so contact erasure can remove it.
model AiUnansweredAsk {
  id               String               @id @default(uuid(7)) @db.Uuid
  questionId       String               @map("question_id") @db.Uuid
  question         AiUnansweredQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  aiConversationId String               @map("ai_conversation_id") @db.Uuid
  aiConversation   AiConversation       @relation(fields: [aiConversationId], references: [id], onDelete: Cascade)
  askedAt          DateTime             @default(now()) @map("asked_at") @db.Timestamptz

  @@index([questionId])
  @@index([aiConversationId])
  @@map("ai_unanswered_asks")
}

/// Daily usage per kind, agent, number and test flag (unique expression index in the migration).
model AiUsageDaily {
  id               String      @id @default(uuid(7)) @db.Uuid
  day              DateTime    @db.Date
  kind             AiUsageKind
  agentId          String?     @map("agent_id") @db.Uuid
  numberId         String?     @map("number_id") @db.Uuid
  test             Boolean     @default(false)
  count            Int         @default(0)
  inputTokens      BigInt      @default(0) @map("input_tokens")
  cacheReadTokens  BigInt      @default(0) @map("cache_read_tokens")
  cacheWriteTokens BigInt      @default(0) @map("cache_write_tokens")
  outputTokens     BigInt      @default(0) @map("output_tokens")
  costMicros       BigInt      @default(0) @map("cost_micros")

  @@index([day])
  @@map("ai_usage_daily")
}

/// Running totals of a month against the limits, and the alert level already sent (FR-038).
model AiUsageMonth {
  month               DateTime @id @db.Date
  replies             Int      @default(0)
  assistantRequests   Int      @default(0) @map("assistant_requests")
  replyAlertLevel     Int      @default(0) @map("reply_alert_level") @db.SmallInt
  assistantAlertLevel Int      @default(0) @map("assistant_alert_level") @db.SmallInt

  @@map("ai_usage_months")
}

/// A member's request to the team assistant (US9).
model AssistantRequest {
  id               String                 @id @default(uuid(7)) @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  user             User                   @relation("AssistantRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  prompt           String
  status           AssistantRequestStatus @default(QUEUED)
  reply            String?
  drafts           Json                   @default("[]")
  errorCode        String?                @map("error_code") @db.VarChar(40)
  inputTokens      Int                    @default(0) @map("input_tokens")
  cacheReadTokens  Int                    @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int                    @default(0) @map("cache_write_tokens")
  outputTokens     Int                    @default(0) @map("output_tokens")
  costMicros       BigInt                 @default(0) @map("cost_micros")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz
  finishedAt       DateTime?              @map("finished_at") @db.Timestamptz

  actions AssistantAction[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("assistant_requests")
}

/// An action the assistant prepared; it runs only when its member confirms it (FR-044).
model AssistantAction {
  id        String                @id @default(uuid(7)) @db.Uuid
  requestId String                @map("request_id") @db.Uuid
  request   AssistantRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String                @map("user_id") @db.Uuid
  user      User                  @relation("AssistantActionUser", fields: [userId], references: [id], onDelete: Cascade)
  kind      AssistantActionKind
  params    Json
  preview   Json
  status    AssistantActionStatus @default(PENDING)
  expiresAt DateTime              @map("expires_at") @db.Timestamptz
  decidedAt DateTime?             @map("decided_at") @db.Timestamptz
  result    Json?
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz

  @@index([requestId])
  @@index([userId, status])
  @@map("assistant_actions")
}

// ---------- Campaign growth (feature 005: specs/005-campaign-growth/data-model.md, T005) ----------

enum ClickDevice {
