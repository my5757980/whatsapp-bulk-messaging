/// One tracked button or link variable of a campaign or a drip step (FR-001, FR-006, FR-007).
/// Exactly one owner (check constraint in the migration).
model TrackedLinkTarget {
  id              String     @id @default(uuid(7)) @db.Uuid
  campaignId      String?    @map("campaign_id") @db.Uuid
  campaign        Campaign?  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  dripStepId      String?    @map("drip_step_id") @db.Uuid
  dripStep        DripStep?  @relation(fields: [dripStepId], references: [id], onDelete: Cascade)
  /// A store cart reminder's cart link (feature 006 US6); a target has exactly one owner.
  storeCartId     String?    @map("store_cart_id") @db.Uuid
  storeCart       StoreCart? @relation(fields: [storeCartId], references: [id], onDelete: Cascade)
  /// 001 variable key, for example BUTTON.0.1 or BODY.2.
  variableKey     String     @map("variable_key") @db.VarChar(20)
  destination     String     @db.VarChar(2000)
  /// Adds utm_source=whatsapp, utm_medium=message and utm_campaign=<name> (FR-007).
  addCampaignTags Boolean    @default(false) @map("add_campaign_tags")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  links TrackedLink[]

  @@unique([campaignId, variableKey])
  @@unique([dripStepId, variableKey])
  @@index([storeCartId])
  @@map("tracked_link_targets")
}

/// One recipient's short link (FR-002). Codes are random and never reused.
model TrackedLink {
  id        String            @id @default(uuid(7)) @db.Uuid
  code      String            @unique @db.Char(10)
  targetId  String            @map("target_id") @db.Uuid
  target    TrackedLinkTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  /// Purged with the message (FR-039).
  messageId String            @map("message_id") @db.Uuid
  message   Message           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// Null after contact deletion.
  contactId String?           @map("contact_id") @db.Uuid
  contact   Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz

  clicks LinkClick[]

  @@unique([messageId, targetId])
  @@index([targetId])
  @@index([contactId])
  @@map("tracked_links")
}

/// One real click (FR-003, FR-004). Previews and robots are only counted in metrics, and no IP
/// address is stored.
model LinkClick {
  id            String      @id @default(uuid(7)) @db.Uuid
  trackedLinkId String      @map("tracked_link_id") @db.Uuid
  trackedLink   TrackedLink @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)
  /// Copied from the link for grouping.
  targetId      String      @map("target_id") @db.Uuid
  /// Copied; null for drips.
  campaignId    String?     @map("campaign_id") @db.Uuid
  /// Copied; null for campaigns.
  dripStepId    String?     @map("drip_step_id") @db.Uuid
  contactId     String?     @map("contact_id") @db.Uuid
  contact       Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  device        ClickDevice
  clickedAt     DateTime    @default(now()) @map("clicked_at") @db.Timestamptz

  @@index([campaignId, contactId])
  @@index([dripStepId, contactId])
  @@index([targetId])
  @@index([contactId])
  @@index([clickedAt])
  // Clicks go with their tracked link (cascade) when 001 purges messages (005 T061).
  @@index([trackedLinkId])
  @@map("link_clicks")
}

/// A round that re-sends a campaign's failed messages (FR-012 – FR-017).
model CampaignRetryRound {
  id         String           @id @default(uuid(7)) @db.Uuid
  campaignId String           @map("campaign_id") @db.Uuid
  campaign   Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// 1–3.
  round      Int              @db.SmallInt
  status     RetryRoundStatus @default(SCHEDULED)
  dueAt      DateTime         @map("due_at") @db.Timestamptz
  startedAt  DateTime?        @map("started_at") @db.Timestamptz
  finishedAt DateTime?        @map("finished_at") @db.Timestamptz
  /// Messages put into the round.
  recipients Int              @default(0)
  /// Of those, the ones that ended SENT, DELIVERED or READ.
  recovered  Int              @default(0)
  /// Why the round was skipped or cancelled.
  note       String?          @db.VarChar(200)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@unique([campaignId, round])
  @@index([status, dueAt])
  @@map("campaign_retry_rounds")
}

/// A drip campaign (FR-018 – FR-031). Names are unique among drips that are not archived, ignoring
/// case (citext and a partial unique index in the migration).
model Drip {
  id           String         @id @default(uuid(7)) @db.Uuid
  name         String         @db.Citext
  numberId     String         @map("number_id") @db.Uuid
  number       WhatsAppNumber @relation(fields: [numberId], references: [id], onDelete: Restrict)
  status       DripStatus     @default(DRAFT)
  /// TEMPLATE_UNAVAILABLE or NUMBER_DISCONNECTED when the drip paused itself; null when a member
  /// paused it.
  pausedReason String?        @map("paused_reason") @db.VarChar(40)
  /// "HH:MM" in the company time zone; both null means no quiet hours. The window may cross
  /// midnight.
  quietFrom    String?        @map("quiet_from") @db.VarChar(5)
  quietTo      String?        @map("quiet_to") @db.VarChar(5)
  /// ISO weekdays (1 = Monday) the quiet hours apply to.
  quietDays    Int[]          @default([1, 2, 3, 4, 5, 6, 7]) @map("quiet_days")
  leaveOnReply Boolean        @default(true) @map("leave_on_reply")
  leaveOnClick Boolean        @default(false) @map("leave_on_click")
  stopTagIds   String[]       @default([]) @map("stop_tag_ids") @db.Uuid
  allowRejoin  Boolean        @default(false) @map("allow_rejoin")
  activatedAt  DateTime?      @map("activated_at") @db.Timestamptz
  pausedAt     DateTime?      @map("paused_at") @db.Timestamptz
  archivedAt   DateTime?      @map("archived_at") @db.Timestamptz
  createdById  String?        @map("created_by_id") @db.Uuid
  createdBy    User?          @relation("DripCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  steps      DripStep[]
  triggers   DripTrigger[]
  enrolments DripEnrolment[]

  @@index([status])
  @@map("drips")
}

/// One step of a drip: a template sent after a wait (FR-019, FR-020).
model DripStep {
  id                 String      @id @default(uuid(7)) @db.Uuid
  dripId             String      @map("drip_id") @db.Uuid
  drip               Drip        @relation(fields: [dripId], references: [id], onDelete: Cascade)
  /// 1–10, unique per drip among live steps (partial unique index in the migration).
  position           Int         @db.SmallInt
  templateId         String      @map("template_id") @db.Uuid
  template           Template    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  /// 001 VariableMapping.
  variableMapping    Json        @default("{}") @map("variable_mapping")
  headerMediaAssetId String?     @map("header_media_asset_id") @db.Uuid
  headerMediaAsset   MediaAsset? @relation("DripStepHeaderMedia", fields: [headerMediaAssetId], references: [id], onDelete: SetNull)
  /// 0 only at position 1; otherwise 10 – 43,200 minutes (30 days).
  waitMinutes        Int         @map("wait_minutes")
  /// Soft delete: results keep their history and waiting contacts move on.
  deletedAt          DateTime?   @map("deleted_at") @db.Timestamptz
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  trackedLinkTargets TrackedLinkTarget[]
  sends              DripStepSend[]
  messages           Message[]

  @@index([dripId])
  @@map("drip_steps")
}

/// A starting event that enrols contacts in a drip (FR-023).
model DripTrigger {
  id         String          @id @default(uuid(7)) @db.Uuid
  dripId     String          @map("drip_id") @db.Uuid
  drip       Drip            @relation(fields: [dripId], references: [id], onDelete: Cascade)
  kind       DripTriggerKind
  /// TAG_ADDED only.
  tagId      String?         @map("tag_id") @db.Uuid
  tag        Tag?            @relation(fields: [tagId], references: [id], onDelete: Cascade)
  /// LINK_CLICKED only; null means any campaign.
  campaignId String?         @map("campaign_id") @db.Uuid
  campaign   Campaign?       @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([dripId])
  @@index([kind])
  @@map("drip_triggers")
}

/// A contact's place in a drip (FR-025 – FR-028). One active enrolment per drip and contact
/// (partial unique index in the migration).
model DripEnrolment {
  id              String          @id @default(uuid(7)) @db.Uuid
  dripId          String          @map("drip_id") @db.Uuid
  drip            Drip            @relation(fields: [dripId], references: [id], onDelete: Cascade)
  /// Null after contact deletion.
  contactId       String?         @map("contact_id") @db.Uuid
  contact         Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  status          EnrolmentStatus @default(ACTIVE)
  joinedVia       DripJoinVia     @map("joined_via")
  /// The member who enrolled the contact by hand.
  joinedById      String?         @map("joined_by_id") @db.Uuid
  joinedBy        User?           @relation("DripEnrolmentJoinedBy", fields: [joinedById], references: [id], onDelete: SetNull)
  /// The next step to send.
  currentPosition Int             @default(1) @map("current_position") @db.SmallInt
  /// Null when finished or left.
  nextDueAt       DateTime?       @map("next_due_at") @db.Timestamptz
  leftReason      DripLeftReason? @map("left_reason")
  joinedAt        DateTime        @default(now()) @map("joined_at") @db.Timestamptz
  /// When the contact finished or left.
  endedAt         DateTime?       @map("ended_at") @db.Timestamptz

  sends    DripStepSend[]
  messages Message[]

  @@index([status, nextDueAt])
  @@index([contactId, status])
  @@index([dripId, status])
  // Retention: enrolments go 12 months after they end (005 T061).
  @@index([endedAt])
  @@map("drip_enrolments")
}

/// What happened at a step for one enrolment (FR-030). The message's own status tells the rest.
model DripStepSend {
  id          String        @id @default(uuid(7)) @db.Uuid
  enrolmentId String        @map("enrolment_id") @db.Uuid
  enrolment   DripEnrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  stepId      String        @map("step_id") @db.Uuid
  step        DripStep      @relation(fields: [stepId], references: [id], onDelete: Cascade)
  outcome     StepOutcome
  /// NO_OPT_IN, TEMPLATE_UNAVAILABLE, ...
  skipReason  String?       @map("skip_reason") @db.VarChar(40)
  messageId   String?       @map("message_id") @db.Uuid
  message     Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@unique([enrolmentId, stepId])
  @@index([stepId])
  @@index([messageId])
  @@map("drip_step_sends")
}

/// Outbox of starting events, written in the transaction that caused them (research R8). Rows are
/// deleted once consumed.
model DripEvent {
  id         BigInt          @id @default(autoincrement())
  kind       DripTriggerKind
  contactId  String          @map("contact_id") @db.Uuid
  tagId      String?         @map("tag_id") @db.Uuid
  campaignId String?         @map("campaign_id") @db.Uuid
  occurredAt DateTime        @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([occurredAt])
  @@map("drip_events")
}

