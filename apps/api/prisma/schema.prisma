/// An admin's webhook endpoint (FR-001, FR-003, FR-006, FR-009).
model WebhookEndpoint {
  id                      String                @id @default(uuid(7)) @db.Uuid
  name                    String                @unique @db.Citext
  url                     String                @db.VarChar(2000)
  eventTypes              String[]              @map("event_types")
  includeContent          Boolean               @default(true) @map("include_content")
  status                  WebhookEndpointStatus @default(ACTIVE)
  secretEncrypted         String                @map("secret_encrypted")
  previousSecretEncrypted String?               @map("previous_secret_encrypted")
  previousSecretUntil     DateTime?             @map("previous_secret_until") @db.Timestamptz
  lastSuccessAt           DateTime?             @map("last_success_at") @db.Timestamptz
  lastFailureAt           DateTime?             @map("last_failure_at") @db.Timestamptz
  failingSince            DateTime?             @map("failing_since") @db.Timestamptz
  /// Failed attempts since the last success, for the auto-pause rule (research R2).
  consecutiveFailures     Int                   @default(0) @map("consecutive_failures")
  createdById             String?               @map("created_by_id") @db.Uuid
  createdBy               User?                 @relation("WebhookEndpointCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  deliveries WebhookDelivery[]

  @@map("webhook_endpoints")
}

/// One event, shared by all its deliveries (research R2, R3).
model OutboundEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  type       String   @db.VarChar(40)
  occurredAt DateTime @map("occurred_at") @db.Timestamptz
  data       Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  deliveries WebhookDelivery[]

  @@index([createdAt])
  @@map("outbound_events")
}

/// One event for one endpoint (FR-005, FR-007).
model WebhookDelivery {
  id             String          @id @default(uuid(7)) @db.Uuid
  endpointId     String          @map("endpoint_id") @db.Uuid
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventId        String          @map("event_id") @db.Uuid
  event          OutboundEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status         DeliveryStatus  @default(PENDING)
  attempts       Int             @default(0) @db.SmallInt
  nextAttemptAt  DateTime?       @map("next_attempt_at") @db.Timestamptz
  lastStatusCode Int?            @map("last_status_code") @db.SmallInt
  lastError      String?         @map("last_error") @db.VarChar(60)
  lastDurationMs Int?            @map("last_duration_ms")
  deliveredAt    DateTime?       @map("delivered_at") @db.Timestamptz
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([endpointId, eventId])
  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt(sort: Desc)])
  @@index([eventId])
  @@map("webhook_deliveries")
}

/// A named API campaign (FR-017, FR-018, FR-021).
model ApiCampaign {
  id                 String            @id @default(uuid(7)) @db.Uuid
  name               String            @db.Citext
  apiName            String            @unique @map("api_name") @db.VarChar(60)
  numberId           String            @map("number_id") @db.Uuid
  number             WhatsAppNumber    @relation(fields: [numberId], references: [id], onDelete: Restrict)
  templateId         String            @map("template_id") @db.Uuid
  template           Template          @relation(fields: [templateId], references: [id], onDelete: Restrict)
  variableMapping    Json              @default("{}") @map("variable_mapping")
  headerMediaAssetId String?           @map("header_media_asset_id") @db.Uuid
  headerMediaAsset   MediaAsset?       @relation("ApiCampaignHeaderMedia", fields: [headerMediaAssetId], references: [id], onDelete: SetNull)
  tags               String[]
  attributes         Json              @default("{}")
  createContacts     Boolean           @default(true) @map("create_contacts")
  dailyLimit         Int?              @map("daily_limit")
  status             ApiCampaignStatus @default(DRAFT)
