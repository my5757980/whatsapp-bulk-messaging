  pausedAt           DateTime?         @map("paused_at") @db.Timestamptz
  stoppedAt          DateTime?         @map("stopped_at") @db.Timestamptz
  createdById        String?           @map("created_by_id") @db.Uuid
  createdBy          User?             @relation("ApiCampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  triggers ApiCampaignTrigger[]
  messages Message[]

  @@index([status])
  @@index([templateId])
  @@index([numberId])
  @@map("api_campaigns")
