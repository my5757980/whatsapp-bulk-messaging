  numberId               String         @map("number_id") @db.Uuid
  number                 WhatsAppNumber @relation(fields: [numberId], references: [id], onDelete: Restrict)
  defaultCountry         String         @map("default_country") @db.Char(2)
  customerTag            String         @map("customer_tag") @db.VarChar(50)
  consentIsWhatsapp      Boolean        @default(false) @map("consent_is_whatsapp")
  consentConfirmedById   String?        @map("consent_confirmed_by_id") @db.Uuid
  consentConfirmedBy     User?          @relation("StoreConsentConfirmedBy", fields: [consentConfirmedById], references: [id], onDelete: SetNull)
  consentConfirmedAt     DateTime?      @map("consent_confirmed_at") @db.Timestamptz
  shippedStatus          String?        @map("shipped_status") @db.VarChar(40)
  deliveredStatus        String?        @map("delivered_status") @db.VarChar(40)
  status                 StoreStatus    @default(CONNECTED)
  lastError              String?        @map("last_error") @db.VarChar(200)
  lastEventAt            DateTime?      @map("last_event_at") @db.Timestamptz
  lastSyncedAt           DateTime?      @map("last_synced_at") @db.Timestamptz
  createdById            String?        @map("created_by_id") @db.Uuid
  createdBy              User?          @relation("StoreCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  events       StoreEvent[]
  automations  StoreAutomation[]
  orders       StoreOrder[]
  carts        StoreCart[]
  catalogFills CatalogConnection[]

  @@index([status])
  @@index([numberId])
  @@map("store_connections")
}

/// A raw store delivery, saved before processing (research R9).
model StoreEvent {
  id          BigInt           @id @default(autoincrement())
  storeId     String           @map("store_id") @db.Uuid
  store       StoreConnection  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  externalId  String           @map("external_id") @db.VarChar(100)
  topic       String           @db.VarChar(60)
  payload     Json
  status      StoreEventStatus @default(RECEIVED)
  error       String?          @db.VarChar(200)
  receivedAt  DateTime         @default(now()) @map("received_at") @db.Timestamptz
  processedAt DateTime?        @map("processed_at") @db.Timestamptz

  @@unique([storeId, externalId])
  @@index([receivedAt])
  @@index([status, receivedAt])
  @@map("store_events")
}

/// One automation of a store (FR-029, FR-034, FR-039).
model StoreAutomation {
  id          String              @id @default(uuid(7)) @db.Uuid
  storeId     String              @map("store_id") @db.Uuid
  store       StoreConnection     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind        StoreAutomationKind
  enabled     Boolean             @default(false)
  steps       Json                @default("[]")
  settings    Json                @default("{}")
  updatedById String?             @map("updated_by_id") @db.Uuid
  updatedBy   User?               @relation("StoreAutomationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([storeId, kind])
  @@map("store_automations")
}

/// An order seen from a store (FR-030, FR-035 - FR-037).
model StoreOrder {
  id             String          @id @default(uuid(7)) @db.Uuid
  storeId        String          @map("store_id") @db.Uuid
  store          StoreConnection @relation(fields: [storeId], references: [id], onDelete: Cascade)
  externalId     String          @map("external_id") @db.VarChar(64)
  orderNumber    String          @map("order_number") @db.VarChar(40)
  contactId      String?         @map("contact_id") @db.Uuid
  contact        Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  phoneE164      String?         @map("phone_e164") @db.VarChar(16)
  phoneSource    String?         @map("phone_source") @db.VarChar(10)
  customerName   String?         @map("customer_name") @db.VarChar(120)
  total          Decimal         @db.Decimal(14, 2)
  currency       String          @db.Char(3)
  paymentKind    PaymentKind     @map("payment_kind")
  status         String          @db.VarChar(30)
  placedAt       DateTime        @map("placed_at") @db.Timestamptz
  storeUpdatedAt DateTime        @map("store_updated_at") @db.Timestamptz
  codStatus      CodStatus       @default(NONE) @map("cod_status")
  codAskedAt     DateTime?       @map("cod_asked_at") @db.Timestamptz
  codAnsweredAt  DateTime?       @map("cod_answered_at") @db.Timestamptz
  codNextAt      DateTime?       @map("cod_next_at") @db.Timestamptz
  codReminded    Boolean         @default(false) @map("cod_reminded")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  messages         StoreOrderMessage[]
  sentMessages     Message[]
  recoveredCarts   StoreCart[]
  /// The Pay now request sent for this order (feature 008, PAY_LINK).
  paymentRequestId String?             @map("payment_request_id") @db.Uuid
  paidViaLinkAt    DateTime?           @map("paid_via_link_at") @db.Timestamptz

  @@unique([storeId, externalId])
  @@index([codStatus, codNextAt])
  @@index([contactId])
  @@index([storeId, placedAt])
  @@index([createdAt])
  @@map("store_orders")
}

/// Each notification or COD message of an order, at most once except COD_REPLY (FR-030).
model StoreOrderMessage {
  id         String           @id @default(uuid(7)) @db.Uuid
  orderId    String           @map("order_id") @db.Uuid
  order      StoreOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind       StoreMessageKind
  outcome    StepOutcome
  skipReason String?          @map("skip_reason") @db.VarChar(40)
  messageId  String?          @map("message_id") @db.Uuid
  message    Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([orderId])
  @@index([messageId])
  @@map("store_order_messages")
}

/// A checkout that may become an abandoned cart (FR-039 - FR-044).
model StoreCart {
  id               String          @id @default(uuid(7)) @db.Uuid
  storeId          String          @map("store_id") @db.Uuid
  store            StoreConnection @relation(fields: [storeId], references: [id], onDelete: Cascade)
  externalId       String          @map("external_id") @db.VarChar(64)
  contactId        String?         @map("contact_id") @db.Uuid
  contact          Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  phoneE164        String?         @map("phone_e164") @db.VarChar(16)
  value            Decimal         @db.Decimal(14, 2)
  currency         String          @db.Char(3)
  itemsSummary     String?         @map("items_summary") @db.VarChar(300)
  cartUrl          String?         @map("cart_url") @db.VarChar(2000)
  startedAt        DateTime        @map("started_at") @db.Timestamptz
  storeUpdatedAt   DateTime        @map("store_updated_at") @db.Timestamptz
  status           CartStatus      @default(OPEN)
  stopReason       String?         @map("stop_reason") @db.VarChar(40)
  nextStep         Int             @default(1) @map("next_step") @db.SmallInt
  nextAt           DateTime?       @map("next_at") @db.Timestamptz
  lastReminderAt   DateTime?       @map("last_reminder_at") @db.Timestamptz
  recoveredOrderId String?         @map("recovered_order_id") @db.Uuid
  recoveredOrder   StoreOrder?     @relation(fields: [recoveredOrderId], references: [id], onDelete: SetNull)
  recoveredValue   Decimal?        @map("recovered_value") @db.Decimal(14, 2)
  recoveredAt      DateTime?       @map("recovered_at") @db.Timestamptz
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  reminders    StoreCartReminder[]
  sentMessages Message[]
  linkTargets  TrackedLinkTarget[]

  @@unique([storeId, externalId])
  @@index([status, nextAt])
  @@index([contactId])
  @@index([recoveredOrderId])
  @@index([createdAt])
  @@map("store_carts")
}

model StoreCartReminder {
  id         String      @id @default(uuid(7)) @db.Uuid
  cartId     String      @map("cart_id") @db.Uuid
  cart       StoreCart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  step       Int         @db.SmallInt
  outcome    StepOutcome
  skipReason String?     @map("skip_reason") @db.VarChar(40)
  messageId  String?     @map("message_id") @db.Uuid
  message    Message?    @relation(fields: [messageId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@unique([cartId, step])
  @@index([messageId])
  @@map("store_cart_reminders")
}

/// A chat link and its QR code (FR-045 - FR-050).
model ChatLink {
  id          String         @id @default(uuid(7)) @db.Uuid
  name        String         @db.Citext
  numberId    String         @map("number_id") @db.Uuid
  number      WhatsAppNumber @relation(fields: [numberId], references: [id], onDelete: Restrict)
  message     String         @db.VarChar(500)
  ref         String         @unique @db.Char(6)
  code        String         @unique @db.Char(10)
  flowId      String?        @map("flow_id") @db.Uuid
  flow        Flow?          @relation(fields: [flowId], references: [id], onDelete: SetNull)
  tagId       String?        @map("tag_id") @db.Uuid
  tag         Tag?           @relation(fields: [tagId], references: [id], onDelete: SetNull)
  status      ChatLinkStatus @default(ACTIVE)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz
  createdById String?        @map("created_by_id") @db.Uuid
  createdBy   User?          @relation("ChatLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  opens  ChatLinkOpen[]
  starts ChatLinkStart[]

  @@index([numberId])
  @@index([flowId])
  @@index([tagId])
  @@map("chat_links")
}

/// One opening of a chat link; no IP is stored (FR-047).
model ChatLinkOpen {
  id         String      @id @default(uuid(7)) @db.Uuid
  chatLinkId String      @map("chat_link_id") @db.Uuid
  chatLink   ChatLink    @relation(fields: [chatLinkId], references: [id], onDelete: Cascade)
  device     ClickDevice
  openedAt   DateTime    @default(now()) @map("opened_at") @db.Timestamptz

  @@index([chatLinkId, openedAt])
  @@index([openedAt])
  @@map("chat_link_opens")
}

/// A chat started from a chat link's pre-filled message (FR-048).
model ChatLinkStart {
  id             String        @id @default(uuid(7)) @db.Uuid
  chatLinkId     String        @map("chat_link_id") @db.Uuid
  chatLink       ChatLink      @relation(fields: [chatLinkId], references: [id], onDelete: Cascade)
  contactId      String?       @map("contact_id") @db.Uuid
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversationId String?       @map("conversation_id") @db.Uuid
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  newContact     Boolean       @map("new_contact")
  startedAt      DateTime      @default(now()) @map("started_at") @db.Timestamptz

  @@index([chatLinkId, startedAt])
  @@index([contactId])
  @@index([conversationId])
  @@index([startedAt])
  @@map("chat_link_starts")
}

/// One number connection wizard run (FR-051 - FR-055); no token is stored here.
model NumberConnectionCheck {
  id            String          @id @default(uuid(7)) @db.Uuid
  numberId      String?         @map("number_id") @db.Uuid
  number        WhatsAppNumber? @relation(fields: [numberId], references: [id], onDelete: SetNull)
  wabaId        String?         @map("waba_id") @db.VarChar(40)
  phoneNumberId String?         @map("phone_number_id") @db.VarChar(40)
  results       Json            @default("[]")
  runById       String?         @map("run_by_id") @db.Uuid
  runBy         User?           @relation("NumberCheckRunBy", fields: [runById], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@index([numberId])
  @@index([createdAt])
  @@map("number_connection_checks")
}

/// Saved answers of changing public API calls sent with an Idempotency-Key (feature 006, FR-015).
model ApiIdempotentResponse {
  id          String   @id @default(uuid(7)) @db.Uuid
  apiKeyId    String   @map("api_key_id") @db.Uuid
  apiKey      ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  key         String   @db.VarChar(255)
  requestHash String   @map("request_hash")
  status      Int      @db.SmallInt
  body        Json
  expiresAt   DateTime @map("expires_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([apiKeyId, key])
  @@index([expiresAt])
  @@map("api_idempotent_responses")
}

// ---------- Feature 007: ads manager (specs/007-ads-manager/data-model.md) ----------

enum AdsConnectionStatus {
  CONNECTED
  ERROR
}

enum AdGoal {
  CHATS
  LEADS
  WEBSITE
}

enum AdCampaignStatus {
  DRAFT
  SUBMITTING
  IN_REVIEW
  ACTIVE
  PAUSED
  REJECTED
  ENDED
  ERROR
}

enum AdSpecialCategory {
  NONE
  CREDIT
  EMPLOYMENT
  HOUSING
  SOCIAL_ISSUES
}

enum AdMediaKind {
  IMAGE
  VIDEO
}

enum AdVersionStatus {
  DRAFT
  IN_REVIEW
  ACTIVE
  PAUSED
  REJECTED
  ENDED
}

enum AdAudienceKind {
  CUSTOM
  LOOKALIKE
}

enum AdAudienceStatus {
  SYNCING
  READY
  TOO_SMALL
  ERROR
}

enum AdLeadStatus {
  PROCESSED
  NO_PHONE
  INVALID_PHONE
  FAILED
}

/// The company's ad account and page (R1, R2). One row (index in the migration tail).
model AdsConnection {
  id              String              @id @default(uuid(7)) @db.Uuid
  adAccountId     String              @map("ad_account_id") @db.VarChar(40)
  adAccountName   String              @map("ad_account_name") @db.VarChar(200)
  pageId          String              @map("page_id") @db.VarChar(40)
  pageName        String              @map("page_name") @db.VarChar(200)
  /// System user token, encrypted with the 001 TokenCipher; never returned.
  tokenEnc        String              @map("token_enc")
  pageTokenEnc    String?             @map("page_token_enc")
  currency        String              @db.Char(3)
  timezone        String              @db.VarChar(64)
  status          AdsConnectionStatus @default(CONNECTED)
  checks          Json                @default("{}")
  checkedAt       DateTime?           @map("checked_at") @db.Timestamptz
  monthlyCapMinor BigInt?             @map("monthly_cap_minor")
  /// YYYY-MM when the cap paused the platform's ads, so they are paused once a month.
  cappedMonth     String?             @map("capped_month") @db.Char(7)
  connectedById   String?             @map("connected_by_id") @db.Uuid
  connectedBy     User?               @relation("AdsConnectedBy", fields: [connectedById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  @@map("ads_connections")
}

/// What a manager builds: one Meta campaign and ad set with up to five ads (R3).
model AdCampaign {
  id                String            @id @default(uuid(7)) @db.Uuid
  name              String            @db.Citext
  goal              AdGoal
  status            AdCampaignStatus  @default(DRAFT)
  numberId          String?           @map("number_id") @db.Uuid
  number            WhatsAppNumber?   @relation(fields: [numberId], references: [id], onDelete: Restrict)
  prefilledMessage  String?           @map("prefilled_message") @db.VarChar(300)
  welcomeSequenceId String?           @map("welcome_sequence_id") @db.VarChar(40)
  leadFormId        String?           @map("lead_form_id") @db.Uuid
  leadForm          AdLeadForm?       @relation(fields: [leadFormId], references: [id], onDelete: Restrict)
  websiteUrl        String?           @map("website_url") @db.VarChar(2000)
  linkCode          String?           @unique @map("link_code") @db.Char(10)
  targeting         Json
  placements        Json
  specialCategory   AdSpecialCategory @default(NONE) @map("special_category")
  dailyBudgetMinor  BigInt            @map("daily_budget_minor")
  currency          String            @db.Char(3)
  startAt           DateTime          @map("start_at") @db.Timestamptz
  endAt             DateTime?         @map("end_at") @db.Timestamptz
  flowId            String?           @map("flow_id") @db.Uuid
  flow              Flow?             @relation(fields: [flowId], references: [id], onDelete: SetNull)
  tagId             String?           @map("tag_id") @db.Uuid
  tag               Tag?              @relation(fields: [tagId], references: [id], onDelete: SetNull)
  metaCampaignId    String?           @map("meta_campaign_id") @db.VarChar(40)
  metaAdsetId       String?           @map("meta_adset_id") @db.VarChar(40)
  metaStatus        String?           @map("meta_status") @db.VarChar(40)
  lastError         String?           @map("last_error") @db.VarChar(500)
  syncedAt          DateTime?         @map("synced_at") @db.Timestamptz
  submittedAt       DateTime?         @map("submitted_at") @db.Timestamptz
  endedAt           DateTime?         @map("ended_at") @db.Timestamptz
  createdById       String?           @map("created_by_id") @db.Uuid
  createdBy         User?             @relation("AdCampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  versions   AdVersion[]
  resultDays AdResultDay[]
  chatStarts AdChatStart[]
  leads      AdLead[]
  linkOpens  AdLinkOpen[]

  @@index([status])
  @@index([flowId])
  @@index([tagId])
  @@index([numberId])
  @@index([leadFormId])
  @@map("ad_campaigns")
}

/// One creative of a campaign; one ad at Meta.
model AdVersion {
  id             String          @id @default(uuid(7)) @db.Uuid
  adCampaignId   String          @map("ad_campaign_id") @db.Uuid
  adCampaign     AdCampaign      @relation(fields: [adCampaignId], references: [id], onDelete: Cascade)
  position       Int             @db.SmallInt
  mediaAssetId   String          @map("media_asset_id") @db.Uuid
  mediaAsset     MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  mediaKind      AdMediaKind     @map("media_kind")
  metaImageHash  String?         @map("meta_image_hash") @db.VarChar(100)
  metaVideoId    String?         @map("meta_video_id") @db.VarChar(100)
  primaryText    String          @map("primary_text") @db.VarChar(2200)
  headline       String          @db.VarChar(255)
  callToAction   String          @map("call_to_action") @db.VarChar(40)
  metaCreativeId String?         @map("meta_creative_id") @db.VarChar(40)
  metaAdId       String?         @unique @map("meta_ad_id") @db.VarChar(40)
  status         AdVersionStatus @default(DRAFT)
  reviewFeedback String?         @map("review_feedback") @db.VarChar(1000)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  resultDays AdResultDay[]
  chatStarts AdChatStart[]

  @@unique([adCampaignId, position])
  @@index([mediaAssetId])
  @@map("ad_versions")
}

/// Meta's numbers for a campaign (ad_version_id null, for reach) or a version on one day (R7).
model AdResultDay {
  id                String     @id @default(uuid(7)) @db.Uuid
  adCampaignId      String     @map("ad_campaign_id") @db.Uuid
  adCampaign        AdCampaign @relation(fields: [adCampaignId], references: [id], onDelete: Cascade)
  adVersionId       String?    @map("ad_version_id") @db.Uuid
  adVersion         AdVersion? @relation(fields: [adVersionId], references: [id], onDelete: Cascade)
  day               DateTime   @db.Date
  impressions       BigInt     @default(0)
  reach             BigInt     @default(0)
  clicks            BigInt     @default(0)
  spendMinor        BigInt     @default(0) @map("spend_minor")
  metaConversations Int        @default(0) @map("meta_conversations")
  metaLeads         Int        @default(0) @map("meta_leads")
  readAt            DateTime   @map("read_at") @db.Timestamptz

  @@index([adCampaignId, day])
  @@index([adVersionId])
  @@index([day])
  @@map("ad_result_days")
}

/// A chat that began from an ad (R11); a contact once a day per ad (index in the migration tail).
model AdChatStart {
  id             String        @id @default(uuid(7)) @db.Uuid
  metaAdId       String        @map("meta_ad_id") @db.VarChar(40)
  adCampaignId   String?       @map("ad_campaign_id") @db.Uuid
  adCampaign     AdCampaign?   @relation(fields: [adCampaignId], references: [id], onDelete: SetNull)
  adVersionId    String?       @map("ad_version_id") @db.Uuid
  adVersion      AdVersion?    @relation(fields: [adVersionId], references: [id], onDelete: SetNull)
  contactId      String?       @map("contact_id") @db.Uuid
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversationId String?       @map("conversation_id") @db.Uuid
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  newContact     Boolean       @map("new_contact")
  headline       String?       @db.VarChar(500)
  body           String?       @db.VarChar(500)
  mediaUrl       String?       @map("media_url") @db.VarChar(2000)
  sourceUrl      String?       @map("source_url") @db.VarChar(2000)
  ctwaClid       String?       @map("ctwa_clid") @db.VarChar(200)
  startedAt      DateTime      @default(now()) @map("started_at") @db.Timestamptz

  @@index([adCampaignId, startedAt])
  @@index([adVersionId])
  @@index([contactId])
  @@index([conversationId])
  @@index([metaAdId])
  @@index([startedAt])
  @@map("ad_chat_starts")
}

/// A saved audience at Meta (R8).
model AdAudience {
  id               String           @id @default(uuid(7)) @db.Uuid
  name             String           @db.Citext
  kind             AdAudienceKind
  source           Json?
  originAudienceId String?          @map("origin_audience_id") @db.Uuid
  originAudience   AdAudience?      @relation("AdAudienceLookalikes", fields: [originAudienceId], references: [id], onDelete: Cascade)
  lookalikes       AdAudience[]     @relation("AdAudienceLookalikes")
  lookalikeCountry String?          @map("lookalike_country") @db.Char(2)
  lookalikeRatio   Decimal?         @map("lookalike_ratio") @db.Decimal(4, 2)
  metaAudienceId   String?          @map("meta_audience_id") @db.VarChar(40)
  memberCount      Int              @default(0) @map("member_count")
  status           AdAudienceStatus @default(SYNCING)
  lastError        String?          @map("last_error") @db.VarChar(500)
  syncedAt         DateTime?        @map("synced_at") @db.Timestamptz
  createdById      String?          @map("created_by_id") @db.Uuid
  createdBy        User?            @relation("AdAudienceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  members AdAudienceMember[]

  @@index([originAudienceId])
  @@map("ad_audiences")
}

/// The hashes sent to Meta, so daily syncs send only the difference (R8). No contact foreign key:
/// a deleted contact's row stays until the next sync removes it at Meta.
model AdAudienceMember {
  audienceId String     @map("audience_id") @db.Uuid
  audience   AdAudience @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  contactId  String     @map("contact_id") @db.Uuid
  phoneHash  String     @map("phone_hash") @db.Char(64)
  addedAt    DateTime   @default(now()) @map("added_at") @db.Timestamptz

  @@id([audienceId, contactId])
  @@index([contactId])
  @@map("ad_audience_members")
}

/// A lead form at Meta (R9).
model AdLeadForm {
  id                String    @id @default(uuid(7)) @db.Uuid
  name              String    @unique @db.Citext
  questions         Json
  privacyUrl        String    @map("privacy_url") @db.VarChar(2000)
  consentText       String    @map("consent_text") @db.VarChar(300)
  tagId             String?   @map("tag_id") @db.Uuid
  tag               Tag?      @relation(fields: [tagId], references: [id], onDelete: SetNull)
  welcomeTemplateId String?   @map("welcome_template_id") @db.Uuid
  welcomeTemplate   Template? @relation(fields: [welcomeTemplateId], references: [id], onDelete: SetNull)
  welcomeMapping    Json      @default("{}") @map("welcome_mapping")
  metaFormId        String?   @unique @map("meta_form_id") @db.VarChar(40)
  lastLeadAt        DateTime? @map("last_lead_at") @db.Timestamptz
  createdById       String?   @map("created_by_id") @db.Uuid
  createdBy         User?     @relation("AdLeadFormCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  campaigns AdCampaign[]
  leads     AdLead[]

  @@index([tagId])
  @@index([welcomeTemplateId])
  @@map("ad_lead_forms")
}

/// One person's answers to a form; recorded once by Meta's id (R9).
model AdLead {
  id           String       @id @default(uuid(7)) @db.Uuid
  formId       String       @map("form_id") @db.Uuid
  form         AdLeadForm   @relation(fields: [formId], references: [id], onDelete: Cascade)
  metaLeadId   String       @unique @map("meta_lead_id") @db.VarChar(40)
  metaAdId     String?      @map("meta_ad_id") @db.VarChar(40)
  adCampaignId String?      @map("ad_campaign_id") @db.Uuid
  adCampaign   AdCampaign?  @relation(fields: [adCampaignId], references: [id], onDelete: SetNull)
  answers      Json         @default("{}")
  phoneE164    String?      @map("phone_e164") @db.VarChar(16)
  email        String?      @db.VarChar(320)
  consent      Boolean      @default(false)
  contactId    String?      @map("contact_id") @db.Uuid
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  status       AdLeadStatus
  submittedAt  DateTime     @map("submitted_at") @db.Timestamptz
  receivedAt   DateTime     @default(now()) @map("received_at") @db.Timestamptz

  messages Message[]

  @@index([formId, submittedAt])
  @@index([adCampaignId])
  @@index([contactId])
  @@index([receivedAt])
  @@map("ad_leads")
}

/// Website ad visits through /l/a/:code (R10). No IP is stored.
model AdLinkOpen {
  id           String      @id @default(uuid(7)) @db.Uuid
  adCampaignId String      @map("ad_campaign_id") @db.Uuid
  adCampaign   AdCampaign  @relation(fields: [adCampaignId], references: [id], onDelete: Cascade)
  device       ClickDevice
  openedAt     DateTime    @default(now()) @map("opened_at") @db.Timestamptz

  @@index([adCampaignId, openedAt])
  @@index([openedAt])
  @@map("ad_link_opens")
}

// ---------- Commerce and payments (feature 008, data-model.md) ----------

enum PaymentProvider {
  STRIPE
}

enum GatewayMode {
  LIVE
  TEST
}

enum GatewayStatus {
  CONNECTED
  ERROR
}

enum PaymentStatus {
  WAITING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}

enum PaymentSource {
  INBOX
  FLOW
  CAMPAIGN
  API
  STORE_ORDER
  CHAT_ORDER
}

enum PaymentEventSource {
  WEBHOOK
  RECONCILE
  CHECK
}

enum PaymentEventResult {
  PENDING
  APPLIED
  IGNORED
  DUPLICATE
  REJECTED
  FAILED
}

enum ChatOrderMode {
  AUTO
  REVIEW
  FLOW
}

enum ChatOrderStatus {
  RECEIVED
  LINK_SENT
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormVersionStatus {
  PUBLISHED
  FAILED
  DEPRECATED
}

enum FormCategory {
  SIGN_UP
  APPOINTMENT_BOOKING
  LEAD_GENERATION
  CONTACT_US
  CUSTOMER_SUPPORT
  SURVEY
  OTHER
}

/// The company's Stripe account; one row at most (FR-001 - FR-005, R1, R4).
model PaymentGateway {
  id                       String          @id @default(uuid(7)) @db.Uuid
  provider                 PaymentProvider @default(STRIPE)
  mode                     GatewayMode
  accountId                String?         @map("account_id") @db.VarChar(64)
  accountName              String?         @map("account_name") @db.VarChar(200)
  country                  String?         @db.Char(2)
  /// The connection currency, lower case (aed); one per connection.
  currency                 String          @db.Char(3)
  /// Restricted or secret key, encrypted with the 001 TokenCipher; never returned.
  secretKeyEnc             String          @map("secret_key_enc")
  /// restricted | secret
  keyKind                  String          @map("key_kind") @db.VarChar(10)
  webhookSecretEnc         String?         @map("webhook_secret_enc")
  previousWebhookSecretEnc String?         @map("previous_webhook_secret_enc")
  previousSecretUntil      DateTime?       @map("previous_secret_until") @db.Timestamptz
  /// Set when the platform registered the endpoint; deleted on disconnect.
  webhookEndpointId        String?         @map("webhook_endpoint_id") @db.VarChar(64)
  status                   GatewayStatus   @default(CONNECTED)
  checks                   Json            @default("[]")
  /// {status: NOT_RUN | PENDING | PASSED | FAILED, sessionId?, startedAt?, passedAt?, fix?}
  notificationCheck        Json            @default("{\"status\":\"NOT_RUN\"}") @map("notification_check")
  lastCheckedAt            DateTime?       @map("last_checked_at") @db.Timestamptz
  lastEventAt              DateTime?       @map("last_event_at") @db.Timestamptz
  /// The reconciler's position in Stripe's event list (created time).
  eventsCursor             DateTime?       @map("events_cursor") @db.Timestamptz
  connectedById            String?         @map("connected_by_id") @db.Uuid
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@map("payment_gateways")
}

/// Payment settings; one row, created with defaults (FR-006 - FR-008, FR-017, FR-027).
model PaymentSettings {
  id                     String        @id @default(uuid(7)) @db.Uuid
  maxAmountMinor         BigInt        @default(1000000) @map("max_amount_minor")
  defaultExpiryMinutes   Int           @default(1440) @map("default_expiry_minutes")
  requestRoles           String[]      @default(["ADMIN", "MANAGER", "AGENT"]) @map("request_roles")
  sessionText            String        @default("{description}\nAmount: {amount}\nPlease pay by {expires}.") @map("session_text") @db.VarChar(1024)
  buttonText             String        @default("Pay now") @map("button_text") @db.VarChar(20)
  templateId             String?       @map("template_id") @db.Uuid
  template               Template?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateMapping        Json          @default("{}") @map("template_mapping")
  /// Up to two: [{beforeMinutes, templateId, mapping}]
  reminders              Json          @default("[]")
  chatOrderMode          ChatOrderMode @default(REVIEW) @map("chat_order_mode")
  chatOrderExpiryMinutes Int           @default(1440) @map("chat_order_expiry_minutes")
  chatOrderTagId         String?       @map("chat_order_tag_id") @db.Uuid
  chatOrderTag           Tag?          @relation(fields: [chatOrderTagId], references: [id], onDelete: SetNull)
  updatedById            String?       @map("updated_by_id") @db.Uuid
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@map("payment_settings")
}

/// One customer's request to pay, from any source (FR-006 - FR-016, R2, R5, R6).
model PaymentRequest {
  id                    String         @id @default(uuid(7)) @db.Uuid
  /// Pay link code: ${PUBLIC_LINK_BASE_URL}/p/{code}
  code                  String         @unique @db.VarChar(16)
  contactId             String?        @map("contact_id") @db.Uuid
  contact               Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversationId        String?        @map("conversation_id") @db.Uuid
  conversation          Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  phoneE164             String?        @map("phone_e164") @db.VarChar(16)
  customerName          String?        @map("customer_name") @db.VarChar(120)
  amountMinor           BigInt         @map("amount_minor")
  currency              String         @db.Char(3)
  description           String         @db.VarChar(250)
  reference             String?        @db.VarChar(80)
  expiresAt             DateTime       @map("expires_at") @db.Timestamptz
  status                PaymentStatus  @default(WAITING)
  source                PaymentSource
  createdById           String?        @map("created_by_id") @db.Uuid
  createdBy             User?          @relation("PaymentRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  apiKeyId              String?        @map("api_key_id") @db.Uuid
  flowSessionId         String?        @map("flow_session_id") @db.Uuid
  campaignId            String?        @map("campaign_id") @db.Uuid
  messageId             String?        @map("message_id") @db.Uuid
  chatItemId            String?        @map("chat_item_id") @db.Uuid
  storeOrderId          String?        @map("store_order_id") @db.Uuid
  chatOrderId           String?        @map("chat_order_id") @db.Uuid
  chatOrder             ChatOrder?     @relation(fields: [chatOrderId], references: [id], onDelete: SetNull)
  tagId                 String?        @map("tag_id") @db.Uuid
  flowId                String?        @map("flow_id") @db.Uuid
  isTest                Boolean        @default(false) @map("is_test")
  sessionId             String?        @map("session_id") @db.VarChar(80)
  sessionUrl            String?        @map("session_url")
  sessionExpiresAt      DateTime?      @map("session_expires_at") @db.Timestamptz
  sessionsCreated       Int            @default(0) @map("sessions_created")
  sessionExpirePending  Boolean        @default(false) @map("session_expire_pending")
  sessionExpireAttempts Int            @default(0) @map("session_expire_attempts")
  paymentIntentId       String?        @map("payment_intent_id") @db.VarChar(80)
  paidAt                DateTime?      @map("paid_at") @db.Timestamptz
  paidAmountMinor       BigInt?        @map("paid_amount_minor")
  paidLate              Boolean        @default(false) @map("paid_late")
  failedAttempts        Int            @default(0) @map("failed_attempts")
  lastFailureCode       String?        @map("last_failure_code") @db.VarChar(60)
  lastFailedAt          DateTime?      @map("last_failed_at") @db.Timestamptz
  refundedMinor         BigInt         @default(0) @map("refunded_minor")
  refundedAt            DateTime?      @map("refunded_at") @db.Timestamptz
  cancelledAt           DateTime?      @map("cancelled_at") @db.Timestamptz
  cancelledById         String?        @map("cancelled_by_id") @db.Uuid
  expiredAt             DateTime?      @map("expired_at") @db.Timestamptz
  remindersSent         Int            @default(0) @map("reminders_sent")
  nextReminderAt        DateTime?      @map("next_reminder_at") @db.Timestamptz
  opens                 Int            @default(0)
  firstOpenedAt         DateTime?      @map("first_opened_at") @db.Timestamptz
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  events                PaymentEvent[]

  @@index([contactId, createdAt])
  @@index([campaignId, status])
  @@index([source, createdAt])
  @@index([createdAt])
  @@index([paymentIntentId])
  @@index([reference])
  @@index([chatOrderId])
  @@index([storeOrderId])
  @@index([flowSessionId])
  @@map("payment_requests")
}

/// Every Stripe notification as received, card details removed; kept 30 days (FR-004, R3).
model PaymentEvent {
  id               String             @id @default(uuid(7)) @db.Uuid
  stripeEventId    String?            @unique @map("stripe_event_id") @db.VarChar(80)
  type             String             @db.VarChar(80)
  livemode         Boolean?
  signatureValid   Boolean            @map("signature_valid")
  source           PaymentEventSource @default(WEBHOOK)
  result           PaymentEventResult @default(PENDING)
  paymentRequestId String?            @map("payment_request_id") @db.Uuid
  paymentRequest   PaymentRequest?    @relation(fields: [paymentRequestId], references: [id], onDelete: SetNull)
  body             Json?
  error            String?            @db.VarChar(500)
  stripeCreatedAt  DateTime?          @map("stripe_created_at") @db.Timestamptz
  receivedAt       DateTime           @default(now()) @map("received_at") @db.Timestamptz
  processedAt      DateTime?          @map("processed_at") @db.Timestamptz

  @@index([receivedAt])
  @@index([paymentRequestId])
  @@index([result, receivedAt])
  @@map("payment_events")
}

/// The Meta catalog linked to the WhatsApp accounts; one row at most (FR-021, FR-022, R8, R9).
model CatalogConnection {
  id            String           @id @default(uuid(7)) @db.Uuid
  catalogId     String           @map("catalog_id") @db.VarChar(40)
  name          String           @db.VarChar(200)
  /// [{wabaId, connected}]
  wabaChecks    Json             @default("[]") @map("waba_checks")
  /// IDLE | RUNNING | FAILED
  syncStatus    String           @default("IDLE") @map("sync_status") @db.VarChar(20)
  lastSyncedAt  DateTime?        @map("last_synced_at") @db.Timestamptz
  productCount  Int              @default(0) @map("product_count")
  lastSyncError String?          @map("last_sync_error") @db.VarChar(500)
  fillStoreId   String?          @map("fill_store_id") @db.Uuid
  fillStore     StoreConnection? @relation(fields: [fillStoreId], references: [id], onDelete: SetNull)
  fillEnabled   Boolean          @default(false) @map("fill_enabled")
  lastFilledAt  DateTime?        @map("last_filled_at") @db.Timestamptz
  fillErrors    Json             @default("[]") @map("fill_errors")
  connectedById String?          @map("connected_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  @@map("catalog_connections")
}

/// The platform's copy of the catalog's products (FR-021, FR-025, R8).
model CatalogProduct {
  id             String    @id @default(uuid(7)) @db.Uuid
  retailerId     String    @unique @map("retailer_id") @db.VarChar(100)
  metaProductId  String?   @map("meta_product_id") @db.VarChar(40)
  name           String    @db.VarChar(200)
  description    String?
  priceMinor     BigInt?   @map("price_minor")
  salePriceMinor BigInt?   @map("sale_price_minor")
  currency       String?   @db.Char(3)
  imageUrl       String?   @map("image_url")
  url            String?
  availability   String    @db.VarChar(30)
  visibility     String?   @db.VarChar(20)
  reviewStatus   String?   @map("review_status") @db.VarChar(20)
  removedAt      DateTime? @map("removed_at") @db.Timestamptz
  fillHash       String?   @map("fill_hash") @db.Char(64)
  storeRef       String?   @map("store_ref") @db.VarChar(80)
  syncedAt       DateTime  @default(now()) @map("synced_at") @db.Timestamptz

  @@index([removedAt])
  @@map("catalog_products")
}

/// A cart a customer sent in chat (FR-026 - FR-029, R11).
model ChatOrder {
  id              String           @id @default(uuid(7)) @db.Uuid
  contactId       String?          @map("contact_id") @db.Uuid
  contact         Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversationId  String?          @map("conversation_id") @db.Uuid
  conversation    Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  chatItemId      String?          @map("chat_item_id") @db.Uuid
  catalogId       String           @map("catalog_id") @db.VarChar(40)
  customerText    String?          @map("customer_text") @db.VarChar(1000)
  /// [{retailerId, name, quantity, itemPriceMinor, currency}]
  items           Json
  currency        String           @db.Char(3)
  totalMinor      BigInt           @map("total_minor")
  /// [{kind, retailerId?, detail}]
  warnings        Json             @default("[]")
  mode            ChatOrderMode
  status          ChatOrderStatus  @default(RECEIVED)
  editedById      String?          @map("edited_by_id") @db.Uuid
  cancelledById   String?          @map("cancelled_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  paymentRequests PaymentRequest[]

  @@index([status, createdAt])
  @@index([contactId, createdAt])
  @@index([createdAt])
  @@map("chat_orders")
}

/// A WhatsApp Form (Meta WhatsApp Flow) built in the platform (FR-030 - FR-035, R12).
model Form {
  id                  String        @id @default(uuid(7)) @db.Uuid
  name                String        @db.Citext
  category            FormCategory
  status              FormStatus    @default(DRAFT)
  /// Shared FormModelSchema: {screens: [...]}
  draft               Json          @default("{\"screens\":[]}")
  /// [{fieldKey, attributeKey}]
  mapping             Json          @default("[]")
  tagIds              String[]      @default([]) @map("tag_ids") @db.Uuid
  changedSincePublish Boolean       @default(true) @map("changed_since_publish")
  currentVersionId    String?       @map("current_version_id") @db.Uuid
  createdById         String?       @map("created_by_id") @db.Uuid
  updatedById         String?       @map("updated_by_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  versions            FormVersion[]
  answers             FormAnswer[]

  @@map("forms")
}

/// One published version of a form, with its Meta flows per WhatsApp account.
model FormVersion {
  id            String            @id @default(uuid(7)) @db.Uuid
  formId        String            @map("form_id") @db.Uuid
  form          Form              @relation(fields: [formId], references: [id], onDelete: Cascade)
  number        Int
  model         Json
  mapping       Json              @default("[]")
  tagIds        String[]          @default([]) @map("tag_ids") @db.Uuid
  flowJson      Json              @map("flow_json")
  /// [{wabaId, flowId, status, errors}]
  metaFlows     Json              @default("[]") @map("meta_flows")
  status        FormVersionStatus @default(PUBLISHED)
  publishedById String?           @map("published_by_id") @db.Uuid
  publishedAt   DateTime          @default(now()) @map("published_at") @db.Timestamptz
  answers       FormAnswer[]

  @@unique([formId, number])
  @@map("form_versions")
}

/// One form submission; kept 12 months, deleted with the contact (FR-034).
model FormAnswer {
  id             String      @id @default(uuid(7)) @db.Uuid
  formId         String      @map("form_id") @db.Uuid
  form           Form        @relation(fields: [formId], references: [id], onDelete: Cascade)
  formVersionId  String      @map("form_version_id") @db.Uuid
  formVersion    FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  contactId      String      @map("contact_id") @db.Uuid
  contact        Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId String?     @map("conversation_id") @db.Uuid
  chatItemId     String?     @map("chat_item_id") @db.Uuid
  /// INBOX | FLOW | TEMPLATE | CAMPAIGN (from the token)
  source         String      @db.VarChar(20)
  flowSessionId  String?     @map("flow_session_id") @db.Uuid
  answers        Json
  saved          Json        @default("{}")
  problems       Json        @default("[]")
  submittedAt    DateTime    @default(now()) @map("submitted_at") @db.Timestamptz

  @@index([formId, submittedAt])
  @@index([contactId, submittedAt])
  @@index([submittedAt])
  @@map("form_answers")
}
