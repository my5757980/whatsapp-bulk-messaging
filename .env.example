# Copy to .env and fill in. Never commit .env (constitution Principle III).

# --- Database (PostgreSQL / Neon) ---
DATABASE_URL=postgresql://wbm:wbm@localhost:5434/wbm
# Used by integration/contract tests; the database is reset on every test run.
DATABASE_URL_TEST=postgresql://wbm:wbm@localhost:5434/wbm_test
# Connections per process (api and worker each); keep the total under the database limit.
DATABASE_POOL_MAX=20

# --- Redis (must use maxmemory-policy noeviction) ---
REDIS_URL=redis://localhost:6380

# --- Object storage (S3-compatible; MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=wbm
S3_ACCESS_KEY=wbm
S3_SECRET_KEY=wbm-secret-key

# --- Security ---
# 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Long random string. Sent as the X-Ops-Token header to /api/health and /metrics.
OPS_TOKEN=
# false locally, true in production (HTTPS)
COOKIE_SECURE=false

# --- App URLs and ports ---
APP_URL=http://localhost:3000
API_PORT=4000
WORKER_PORT=4001
# Where the Next.js server proxies /api/* requests
API_INTERNAL_URL=http://localhost:4000

# --- Meta WhatsApp Cloud API ---
# Local/e2e: http://localhost:4010 (tools/mock-meta). Production: https://graph.facebook.com
META_GRAPH_BASE_URL=http://localhost:4010
# Pinned Graph API version; upgrade deliberately
META_GRAPH_API_VERSION=v27.0
# From the Meta app settings; verifies webhook signatures
# Numeric Meta app id. Needed only to create templates with image/video/document headers
# (Resumable Upload API). Any digits work with tools/mock-meta.
META_APP_ID=
META_APP_SECRET=
# Any long random string; must match the webhook setup in Meta
META_WEBHOOK_VERIFY_TOKEN=

# --- Mock Meta (local/e2e only) ---
MOCK_META_PORT=4010
MOCK_WEBHOOK_TARGET=http://localhost:4000/api/webhooks/meta

# --- Optional ---
# Without SMTP, invitation links are shown to the admin instead of emailed
SMTP_URL=
LOG_LEVEL=info

# --- Live chat browser alerts (feature 002, optional) ---
# Generate with: npx --no-install web-push generate-vapid-keys
# Set all three or leave all three empty (push alerts are then turned off).
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Example subject: mailto:it@company.example
WEB_PUSH_SUBJECT=

# --- AI agent (feature 004, optional) ---
# The company's Anthropic API key (secret; billed per use). Without it agents answer with their
# fallback message and hand the chat to people.
ANTHROPIC_API_KEY=
# Local runs without a key: use mock-meta's free fake model instead.
# ANTHROPIC_BASE_URL=http://localhost:4010/anthropic
ANTHROPIC_BASE_URL=
# Model for customer replies and the team assistant (default claude-opus-5-5).
AI_MODEL=claude-opus-5-5

# --- Campaign growth (feature 005) ---
# Public address of tracked links on the company's own domain (https in production). A link is
# <address>/<code>, answered by the api at /l/<code>. With an address that has no /l path (for
# example https://go.company.example), the reverse proxy must send /<code> to the api's /l/<code>.
# Leave empty to turn link tracking off. Local runs: http://localhost:4000/l
PUBLIC_LINK_BASE_URL=

# --- Integrations (feature 006) ---
# Shopify Admin API version (YYYY-MM, a quarterly release), upgraded on purpose like META_GRAPH_API_VERSION.
SHOPIFY_API_VERSION=2026-10
# Local runs and tests only: lets webhook endpoints and stores use http://localhost.
# Outbound requests are otherwise https-only and never reach private addresses. Refused in production.
OUTBOUND_ALLOW_LOCAL=false

# --- Ads (feature 007) ---
# Hours of Meta's free entry point window shown in live chat for chats from ads (information only).
ADS_FREE_WINDOW_HOURS=72

# --- Payments (feature 008) ---
# Stripe's API address. Leave unset in production (https://api.stripe.com). Local runs: mock-meta.
STRIPE_API_BASE_URL=http://localhost:4010/stripe
# Stripe API version, upgraded on purpose like META_GRAPH_API_VERSION. Stripe keys are entered in the
# dashboard (Payments > Gateway) and stored encrypted; Stripe posts to ${APP_URL}/api/payments/stripe/webhook.
STRIPE_API_VERSION=2026-09-30.endive
